f_hQPPC:f_hQPPC_geid_2026:7:indX:Qmin:Qmax:P_min_ratio:P_max_ratio:N_min_ratio:N_max_ratio
f_fQPPC:f_fQPPC_geid_2026:7:indX:Qmin:Qmax:P_min_ratio:P_max_ratio:N_min_ratio:N_max_ratio
f_fQPPC_rem:f_fQPPC_geid_rem_2025_clean:3:indX:QminC:QmaxC
f_hQPPC_rem:f_hQPPC_geid_rem_2025_clean:3:indX:QminC:QmaxC
#-----------------------------------------------------------------
