f_growth_DETX:f_growth_MOPX2MZOO_2025_clean:5:indcell:indX:QXmin:QXmax:indDETX
#-----------------------------------------------------------------
#---------------LIMITATION PAR DES QUOTA INTRACELLULAIRES---------
