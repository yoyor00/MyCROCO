!
   function f_hydrol_CNP_2026(ili,jcol,indMOP,mu_maxB,indBACC,QminC,QmaxC,QminN,QmaxN,QminP,QmaxP)
!
!---------------------------------------------------------------------------
! This function calcules the rate of particulate detrital organic matter (DET) by bacteria
! based on a fixed turnover time
!
! Variables and parameters and their units:
!-----------------------------------------
! indMOP  : index of DET concentration
! indBACC: index of bacteria C biomass 
! mumax_B: max specific growth rate of bacteria 
!
!
! R. Mauriac  07/09/2009
! Last revision:  M. Baklouti 11/01/2026
!-------------------------------------------------------------------------

    Implicit None

    !-- function:
    Real(8):: f_hydrol_CNP_2026(nx_min:nx_max,ny_min:ny_max,nz_max)

    !-- arguments
    Real(8) :: mu_maxB,indMOP,indBACC,QminC,QmaxC
    Real(8),optional :: QminN,QmaxN,QminP,QmaxP
    Integer :: ili,jcol

    !--local variables:
    integer :: i,j,k,iiMOP,igb,l
    integer :: iiC,iiCell,iielmt,iiorg
    real(8) :: nn
    real(8) :: Q,fQ,Qmin,Qmax,concBX
    character(L_VAR) :: chain,chain2,chain3,natMOP,elMOP
    real(8):: vhydrol(nx_min:nx_max,ny_min:ny_max,nz_max)

    !-- Index of  concentration of detrital particulate organic matter
    iiMOP = nint(indMOP)
    natMOP = var(iiMOP)%scomp
    natMOP = trim(adjustl(natMOP))
    
    !element of MOP:
    elMOP = VAR(iiMOP)%elmt 
    elMOP = trim(adjustl(elMOP))
    
    !-- Index of  cabon concentration of bacteria
    iiC = nint(indBACC)

    ! index of bacterial concentration in cells and in the element of MOP
    iiorg = var(iiC)%idorg
    chain='cell'
    iiCell = f_idorg2id(iiorg,chain)
    iielmt = f_idorg2id(iiorg,elMOP)


!-- Find the specific cell division rate of BAC :
    do l = 1,nscp_cell
        if (mu_growth(l)%idorg == iiCell) then
             igb = l
             exit
        endif
    enddo
 
    if (natMOP == 'MOPL' .or. natMOP == 'DETL') then
     vhydrol(:,:,:) = 0.05 * mu_maxB ! 
     nn=0.2
    elseif (natMOP == 'MOPS' .or. natMOP == 'DETS') then
     vhydrol(:,:,:) = 0.023 * mu_maxB 
     nn=0.2
    else
     vhydrol(:,:,:) = 0.0
    endif


  if (elMOP == 'C') then
     Qmin = QminC
     Qmax = QmaxC
  elseif (elMOP == 'N') then
     Qmin = QminN
     Qmax = QmaxN
     nn=2
  elseif (elMOP == 'P') then
     Qmin = QminP
     Qmax = QmaxP
     nn=2
  endif
    
 !-- Calculation of the hydrolysis function :
 do k=1,nz_max
   do j=ny_min,ny_max
     do i=nx_min,nx_max
        Q = var(iiC)%conc(i,j,k)/(var(iiCell)%conc(i,j,k)+1d-80)

   ! quota function for bacteria in elemt elmtMOP
        fQ = ((QmaxC - Q)/(QmaxC-QminC))
        fQ = max(0.0e0,fQ)
        fQ = min(1.0e0,fQ)

        f_hydrol_CNP_2026(i,j,k) = 0.0d0
        concBX =  var(iiMOP)%conc(i,j,k)

!-- test on  the presence of bacteria and on DET availability                 
        if (var(iiCell)%conc(i,j,k) .gt. 100  .and. &
                    var(iiMOP)%conc(i,j,k) > 1.1 * vhydrol(i,j,k) * concBX *fQ**nn  *dt_bio ) then

            f_hydrol_CNP_2026(i,j,k) =  vhydrol(i,j,k) * concBX * fQ**nn

        endif
     enddo
   enddo
 enddo

end function f_hydrol_CNP_2026
!
