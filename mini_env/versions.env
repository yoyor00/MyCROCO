# Versions used by the experimental mini environment.
#
# The official XIOS GitLab host is not always reachable.  Override these
# variables to use the official repository or another mirror:
#   XIOS_REPO=https://gitlab.ipsl.fr/xios/xios.git XIOS_REF=...
XIOS_REPO="${XIOS_REPO:-https://github.com/barriern/xios2-nico.git}"
XIOS_REF="${XIOS_REF:-xios-2.5.x}"

OASIS_REPO="${OASIS_REPO:-https://gitlab.com/cerfacs/oasis3-mct.git}"
OASIS_REF="${OASIS_REF:-OASIS3-MCT_4.0}"

export XIOS_REPO XIOS_REF OASIS_REPO OASIS_REF
