# Versions used by the experimental mini environment.
#
# Official IPSL XIOS repository.  Override these variables to test another
# checkout or mirror:
#   XIOS_REPO=https://github.com/barriern/xios2-nico.git XIOS_REF=...
XIOS_REPO="${XIOS_REPO:-https://gitlab.in2p3.fr/ipsl/projets/xios-projects/xios.git}"
XIOS_REF="${XIOS_REF:-xios-2.5.x}"

OASIS_REPO="${OASIS_REPO:-https://gitlab.com/cerfacs/oasis3-mct.git}"
OASIS_REF="${OASIS_REF:-OASIS3-MCT_4.0}"

export XIOS_REPO XIOS_REF OASIS_REPO OASIS_REF
