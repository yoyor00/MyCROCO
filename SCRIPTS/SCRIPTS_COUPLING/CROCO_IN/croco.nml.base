&croco_title
  title = <title>
/

&croco_time_stepping
  ntimes = <ocentimes>
  dt = <ocedt>
  ndtfast = <ocendtfast>
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 0.01
/

&croco_s_coord
  theta_s = <theta_s>
  theta_b = <theta_b>
  Tcline = <hc>
/

&croco_use_calendar
  start_date = "<dstart>-<mstart>-<ystart> 00:00:00"
  end_date = "<dend>-<mend>-<yend> 00:00:00"
  dt_his = <oce_his_h>
  dt_avg = <oce_avg_h>
  dt_rst = <oce_rst_h>
/

&croco_history
  ldefhis = .true.
  nwrt = <oce_nhis>
  nrpfhis = 0
  hisname = "./croco_his.nc"
/

&croco_initial
  nrrec = <idx_ini>
  ininame = "./croco_ini.nc"
/

&croco_restart
  nrst =  <oce_nrst> 
  nrpfrst = <idx_rst>
  rstname = "./croco_rst.nc"
/

&croco_grid
  grdname = "./croco_grd.nc"
/

&croco_forcing
  frcname = "./croco_frc.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_bulk_forcing
  bulkname = "./croco_blk.nc"
/

&croco_climatology
  clmname = "./croco_clm.nc"
/

&croco_biology
  bioname = "./croco_frcbio.nc"
/

&croco_boundary
  bry_file = "./croco_bry.nc"
/

&croco_wkb_boundary
  brywkb_file = "./croco_wkb.nc"
/

&croco_sediments
  sedname = "sediment.in"
/

&croco_sediments_mustang
  sedname_must = "paraMUSTANG.txt"
/

&croco_substance
  subsfilename = "parasubstance.txt"
/

&croco_xios_origin_date
  xios_origin_date = "<dorig>-<morig>-<yorig> 00:00:00"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-04
  rdrg2 = 0.d-3
  Zobt = 1.d-2
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_tracer_diff4
  tnu4 = 2*0.d11
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 2*0.d0
/

&croco_wkb_wwave
  wkb_amp = 0.25
  wkb_ang = 190.
  wkb_prd = 8.
  wkb_tide = -2.
  wkb_btg = 1.3
  wkb_gam = 0.38
/

&croco_wkb_roller
  wkb_rsb = 0.1
  wkb_roller = 0.5
/

&croco_averages
  ntsavg = 1
  navg = <oce_navg>
  nrpfavg = 0
  avgname = "./croco_avg.nc"
/

&croco_surf
  ldefsurf = .true.
  nwrtsurf = <oce_nhis>
  nrpfsurf = 0
  surfname = "./croco_surf.nc"
/

&croco_surf_avg
  ldefsurf_avg = .false.
  ntssurf_avg = 1
  nwrtsurf_avg = <oce_navg>
  nrpfsurf_avg = 0
  surfname_avg = "./croco_surf_avg.nc"
/

&croco_stations
  ldefsta = .true.
  nsta = 400
  nrpfsta = 0
  staposname = "stations.in"
  staname = "./stations.nc"
/

&croco_online
  yearnum = <yr1>
  monthnum = <mo1>
  recordsperday = <rpd>
  yearend = <yr2>
  monthend = <mo2>
  pathbulk = "<online_frc>"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = <oce_nhis>
  nrpfdia = 0
