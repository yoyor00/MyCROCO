&croco_title
  title = "Overflow Example"
/

&croco_time_stepping
  ntimes = 2160
  dt = 200
  ndtfast = 15
  ninfo = 10
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 10.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 216
  nrpfhis = 0
  hisname = "over_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "over_rst.nc"
/

&croco_restart
  nrst = 2160
  nrpfrst = -1
  rstname = "over_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 1.
  S0 = 0.
  Tcoef = -1.
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 100.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 100., 0.
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 1*1.e-6
/


! End of namelist
