&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-5
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 3*0.
/

&croco_wkb_wwave
  wkb_amp = 0.18
  wkb_ang = 0.0
  wkb_prd = 8.
  wkb_tide = 0.0
  wkb_btg = 0.6
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.15
  wkb_roller = 1.8
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/


! End of namelist
