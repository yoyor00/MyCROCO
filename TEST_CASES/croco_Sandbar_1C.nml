&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 0.1
  tauT_out = 0.1
  tauM_in = 0.1
  tauM_out = 0.1
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 3*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 3*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-5
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 3*0.
/

&croco_wkb_wwave
  wkb_amp = 0.18
  wkb_ang = 0.0
  wkb_prd = 8.
  wkb_tide = 0.0
  wkb_btg = 0.6
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.15
  wkb_roller = 1.8
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 300
  nrpfdia = 0
  dianame = "sandbar_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 250
  nrpfdia_avg = 0
  dianame_avg = "sandbar_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_diag3D_history_fields
  his_dia3D_tracer = 3*.true.
/

&croco_diag2D_history_fields
  his_dia2D_tracer = 3*.true.
/

&croco_diag3D_average_fields
  avg_dia3D_tracer = 3*.true.
/

&croco_diag2D_average_fields
  avg_dia2D_tracer = 3*.true.
/

&croco_gls_history_fields
  his_tke = .true.
  his_gls = .true.
  his_lscale = .true.
/

&croco_bbl_history_fields
  his_abed = .true.
  his_hripple = .true.
  his_lripple = .true.
  his_zbnot = .true.
  his_zbapp = .true.
  his_bostrw = .true.
/

&croco_wci_history_fields
  his_sup = .true.
  his_ust2d = .true.
  his_vst2d = .true.
/

&croco_wci_history_3d_fields
  his_ust = .true.
  his_vst = .true.
  his_wst = .true.
  his_akb = .true.
  his_akw = .true.
  his_kvf = .true.
  his_calp = .true.
  his_kaps = .true.
/

&croco_wave_history_fields
  his_hrm = .true.
  his_frq = .true.
  his_action = .false.
  his_k_xi = .true.
  his_k_eta = .true.
  his_eps_b = .true.
  his_eps_d = .true.
  his_erol = .true.
  his_eps_r = .true.
/


! End of namelist
