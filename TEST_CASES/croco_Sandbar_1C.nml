&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 0.1
  tauT_out = 0.1
  tauM_in = 0.1
  tauM_out = 0.1
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-5
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 3*0.
/

&croco_wkb_wwave
  wkb_amp = 0.18
  wkb_ang = 0.0
  wkb_prd = 8.
  wkb_tide = 0.0
  wkb_btg = 0.6
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.15
  wkb_roller = 1.8
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 300
  nrpfdia = 0
  dianame = "sandbar_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 250
  nrpfdia_avg = 0
  dianame_avg = "sandbar_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .true.
  out_his_sed_bthk = .true.
  out_his_sed_bpor = .true.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 2*.true.
/

&croco_bbl_history_fields
  out_his_abed = .true.
  out_his_hripple = .true.
  out_his_lripple = .true.
  out_his_zbnot = .true.
  out_his_zbapp = .true.
  out_his_bostrw = .true.
/

&croco_wci_history_fields
  out_his_sup = .true.
  out_his_ust2d = .true.
  out_his_vst2d = .true.
/

&croco_wci_history_3d_fields
  out_his_ust = .true.
  out_his_vst = .true.
  out_his_wst = .true.
  out_his_akb = .true.
  out_his_akw = .true.
  out_his_kvf = .true.
  out_his_calp = .true.
  out_his_kaps = .true.
/

&croco_wave_history_fields
  out_his_hrm = .true.
  out_his_frq = .true.
  out_his_action = .false.
  out_his_k_xi = .true.
  out_his_k_eta = .true.
  out_his_eps_b = .true.
  out_his_eps_d = .true.
  out_his_erol = .true.
  out_his_eps_r = .true.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 3*.true.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 3*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  out_his_aks = .false.
  out_his_swflx = .true.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .true.
  out_his_shflx_lat = .true.
  out_his_shflx_sen = .true.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .true.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .false.
  out_avg_omega = .true.
  out_avg_w = .true.
  out_avg_akv = .true.
  out_avg_bostr = .true.
  out_avg_wstr = .true.
  out_avg_ustr = .true.
  out_avg_vstr = .true.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .true.
  out_avg_shflx_rsw = .true.
/

&croco_salinity_averages_fields
  out_avg_aks = .false.
  out_avg_swflx = .true.
/

&croco_bulk_flux_averages_fields
  out_avg_shflx_rlw = .true.
  out_avg_shflx_lat = .true.
  out_avg_shflx_sen = .true.
/

&croco_hbl_averages_fields
  out_avg_hbl = .true.
/

&croco_lmd_bkpp_averages_fields
  out_avg_hbbl = .true.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  out_avg_diff3d = .false.
/

&croco_biology_averages_fields
  out_avg_hel = .true.
/

&croco_diag3D_history_fields
  out_his_dia3D_tracer = 3*.true.
/

&croco_diag2D_history_fields
  out_his_dia2D_tracer = 3*.true.
/

&croco_diag3D_average_fields
  out_avg_dia3D_tracer = 3*.true.
/

&croco_diag2D_average_fields
  out_avg_dia2D_tracer = 3*.true.
/

&croco_sediment_suspload_history_fields
  out_his_sed_dflx = 2*.true.
  out_his_sed_eflx = 2*.true.
/

&croco_sediment_bedload_history_fields
  out_his_sed_bdlu = 2*.true.
  out_his_sed_bdlv = 2*.true.
/


! End of namelist
