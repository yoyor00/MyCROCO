&croco_testcase
  testcase_name = 'THACKER'
/

&croco_title
  title = "Thacker Example"
/

&croco_time_stepping
  ntimes = 600
  dt = 60
  ndtfast = 30
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  hc = 1.e16
/

&croco_initial
  nrrec = 0
  ininame = "thacker_rst.nc"
/

&croco_wetdry
  D_wetdry = 0.01
/

&croco_history
  ldefhis = .true.
  nwrt = 30
  nrpfhis = 0
  hisname = "thacker_his.nc"
/

&croco_restart
  nrst = 4320
  nrpfrst = -1
  rstname = "thacker_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.e-3
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_vertical_mixing
  Akv_bak = 0.e-5
  Akt_bak = 1*0.e-5
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/



! End of namelist
