&croco_title
  title = "TS_adv_body Example"
/

&croco_time_stepping
  ntimes = 750
  dt = 4
  ndtfast = 1
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 300000000.
/

&croco_history
  ldefhis = .true.
  nwrt = 10
  nrpfhis = 0
  hisname = "croco_his_body_rot.nc"
/

&croco_initial
  nrrec = 0
  ininame = "croco_ini_body_rot.nc"
/

&croco_restart
  nrst = 720
  nrpfrst = -1
  rstname = "croco_rst_body_rot.nc"
/


