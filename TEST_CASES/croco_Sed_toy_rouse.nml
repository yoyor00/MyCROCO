&croco_title
  title = "Sed_toy rouse experiment (Single Column GradP / SCM) TEST MODEL"
/

&croco_time_stepping
  ntimes = 21600
  dt = 2
  ndtfast = 10
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 200000.0d0
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-01 12:00:00"
  dt_his = 1
  dt_avg = 1
  dt_rst = 12
/

&croco_history
  ldefhis = .true.
  nwrt = 1800
  nrpfhis = 0
  hisname = "sed_toy_rouse_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 21600
  nrpfrst = -1
  rstname = "sed_toy_rouse_rst.nc"
/

&croco_bodyforce
  levsfrc = 1
  levbfrc = 1
/

&croco_lin_eos
  R0 = 30.d0
  T0 = 20.d0
  S0 = 35.5d0
  Tcoef = 0.0d-10
  Scoef = 0.0d-10
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sed_toy_rouse.in"
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_Sed_toy.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_Sed_toy.txt"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-03
  rdrg2 = 3.15d-3
  Zobt = 1.d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_vertical_mixing
  Akv_bak = 1.d-4
  Akt_bak = 8*1.d-6
/


! End of namelist
