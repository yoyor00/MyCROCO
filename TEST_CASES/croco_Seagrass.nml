&croco_title
  title = "Seagrass example"
/

&croco_time_stepping
  ntimes = 80000
  dt = 0.0025
  ndtfast = 20
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0d0
  Tcline = 1000000000
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-01 00:03:05"
  dt_his = 0.00006944444
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 400
  nrpfhis = 0
  hisname = "seagrass_his.nc"
/

&croco_initial
  nrrec = 0
/

&croco_restart
  nrst = 172800
  nrpfrst = 0
  rstname = "seagrass_rst.nc"
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_obstruction
  obstname = "TEST_CASES/obstruction_seagrass_para.txt"
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 1.e-4
  Cdb_min = 1.d-15
  Cdb_max = 1.d+2
/

&croco_gamma2
  gamma2 = -1.
/

&croco_gls_history_fields
  his_tke = .false.
  his_gls = .false.
  his_lscale = .false.
/


! End of namelist
