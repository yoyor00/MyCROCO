&croco_title
  title = "TS_adv_body Example"
/

&croco_time_stepping
  ntimes = 750
  dt = 7
  ndtfast = 1
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 300000000.
/

&croco_history
  ldefhis = .true.
  nwrt = 10
  nrpfhis = 0
  hisname = "croco_his_body_rot.nc"
/

&croco_initial
  nrrec = 0
  ininame = "croco_ini_body_rot.nc"
/

&croco_restart
  nrst = 720
  nrpfrst = -1
  rstname = "croco_rst_body_rot.nc"
/

&croco_primary_history_fields
  his_zeta = .false.
  his_ubar = .false.
  his_vbar = .false.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_primary_average_fields
  avg_zeta = .false.
  avg_ubar = .false.
  avg_vbar = .false.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 2*.true.
/

&croco_lin_eos
  R0 = 0.
  T0 = 16.
  S0 = 0.
  Tcoef = 0.2048
  Scoef = 0.
/

&croco_rho0
  rho0 = 1024.d0
/

&croco_bottom_drag
  rdrg = 0.0d-04
  rdrg2 = 0.d-3
  Zobt = 0.d-3
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_tracer_diff4
  tnu4 = 2*0.d11
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 2*0.d0
/

&croco_averages
  ntsavg = 1
  navg = 10
  nrpfavg = 0
  avgname = "croco_avg_body_rot.nc"
/


! End of namelist
