:=============================================================================
:         MODULE SUBSTANCE NAMELIST with  CPP key : SUBSTANCE 
:=============================================================================
:
:-----------------------------------------------------------------------------
: nmlnbvar : number of each type of substance to be defined (other than T & S)
:-----------------------------------------------------------------------------
:    nv_dis : number of dissolved susbtances
:    nv_ncp : number of  Non Constitutive Particulate subtances
:    nv_fix : number of  fixed susbtances (not advected)
:    nv_bent : number of benthic susbtances
:    nv_grav : number of susbtances type GRAVELS (only if cppkey MUSTANG)
:    nv_sand : number of susbtances type SAND (only if cppkey MUSTANG)
:    nv_mud : number of susbtances type MUD (only if cppkey MUSTANG)
:    nv_sorb : number of particulate susbtances sorbed on an other particule
:
 &nmlnbvar
    nv_dis=3
    nv_ncp=0
    nv_fix=0
    nv_bent=0
    nv_grav=0
    nv_sand=2
    nv_mud=1
    nv_sorb=0 /
:-----------------------------------------------------------------------------
: nmlgravels : Characterization of GRAVEL substances (used only if defined 
:              MUSTANG)
:              If nv_grav = 0 this namelist is not read
:-----------------------------------------------------------------------------
:    name_var_n() : string, name of variable
:    long_name_var_n() : string, long name of variable
:    standard_name_var_n() : string, standard name of variable
:    unit_var_n() : string, unit of concentration of variable
:    flx_atm_n() : real, uniform atmospherical deposition (unit/m2/s)
:    cv_rain_n() : real, concentration in rainwater (unit/m3 of water)
:    cini_wat_n() : real, initial concentration in water column (unit/m3)
:    cobc_wat_n() : real, boundaries uniform and constant concentration
:                   (unit/m3)
:    cini_air_n() : real, initial concentration in air
:    l_out_subs_n() : boolean, saving in output file if TRUE
:    cini_sed_n() : real, initial concentration in sediment (quantity/kg of
:                   dry sediment)  (only if cppkey MUSTANG)
:    tocd_n() : real, critical stress of deposition (N/m2)
:    ros_n()  : real, density of particle (kg/m3)
:    l_bedload_n() : boolean, allow bedload transport
:    diam_n() : real, diameter of particles (m)
:
:    GRAVEL substances are never in suspension (bedload only): unlike
:    SAND/MUD/dissolved substances, they have no init_cv_name_n()/
:    obc_cv_name_n() parameter -- their initial and boundary water
:    concentrations are always the uniform cini_wat_n()/cobc_wat_n()
:    constants above, never read from a file.
:
 &nmlgravels
    name_var_n(1)=''
      long_name_var_n(1)=''
      standard_name_var_n(1)=''
      unit_var_n(1)=''
      flx_atm_n(1)=0.0
      cv_rain_n(1)=0.0
      cini_wat_n(1)=0.0
      cobc_wat_n(1)=1.
      cini_sed_n(1)=0.0
      cini_air_n(1)=0.0
      l_out_subs_n(1)=.TRUE.
      l_bedload_n(1)=.TRUE.
      tocd_n(1)=0.0
      ros_n(1)=0.0
      diam_n(1)=0.0 /

:-----------------------------------------------------------------------------
: nmlsands : Characterization of SAND substances (used only if defined 
:            MUSTANG)
:            If nv_sand = 0 this namelist is not read
:-----------------------------------------------------------------------------
:    name_var_n() : string, name of variable
:    long_name_var_n() : string, long name of variable
:    standard_name_var_n() : string, standard name of variable
:    unit_var_n() : string, unit of concentration of variable
:    flx_atm_n() : real, uniform atmospherical deposition (unit/m2/s) 
:    cv_rain_n() : real, concentration in rainwater (unit/m3 of water)
:    cini_wat_n() : real, initial concentration in water column (unit/m3)
:    cini_air_n() : real, initial concentration in air
:    l_out_subs_n() : boolean, saving in output file if TRUE
:    init_cv_name_n() : string, name of substance read from initial condition
:                       file, falling back to its uniform cini_wat_n()
:                       concentration if 'none' or if the variable is not
:                       found. Special value: 'none' skips reading an
:                       initial-file variable for this substance. Left
:                       empty (''), it defaults to name_var_n() (i.e. the
:                       variable is read if present in the init file, same
:                       name as the substance itself)
:    obc_cv_name_n() : string, name of substance read from obc file,
:                       falling back to its uniform cobc_wat_n()
:                       concentration if 'none' or if the variable is not
:                       found. Special values: 'none' skips reading a
:                       bry-file variable for this substance.
:                       'nullGradient' imposes a plain zero-gradient
:                       (Neumann) condition instead (no bry-file value, no
:                       cobc_wat_n()). Left empty (''), it defaults to
:                       name_var_n() (i.e. the variable is read if present
:                       in the bry file, same name as the substance itself)
:    cini_sed_n() : real, initial concentration in sediment (quantity/kg of 
:                   dry sediment)  (only if cppkey MUSTANG)
:    tocd_n() : real, critical stress of deposition (N/m2) 
:    ros_n()  : real, density of particle (kg/m3)
:    l_bedload_n() : boolean, allow bedload transport
:    diam_n() : diameter of particles
:    l_sand2D() : boolean, to treat sand variable as 2D variable
:    l_outsandrouse()  : boolean, to use a reconstitution of a ROUSE profil 
:                        for output in water column (used only if 
:                        l_sand2D is TRUE for this variable)
:
:  WARNING if several sands: start with the coarser sands and continue more 
:  and more finely
:
 &nmlsands
    name_var_n(1)='GRAV'
      long_name_var_n(1)='GRAV'
      standard_name_var_n(1)='GRAV'
      unit_var_n(1)='kg.m-3'
      flx_atm_n(1)=0.0
      cv_rain_n(1)=0.0
      cini_wat_n(1)=0.0
      cini_sed_n(1)=0.2
      cini_air_n(1)=0.0
      l_out_subs_n(1)=.TRUE.
      l_bedload_n(1)=.FALSE.
      init_cv_name_n(1)='GRAV'
      obc_cv_name_n(1)='none'
      tocd_n(1)=1000.
      ros_n(1)=2600.0
      diam_n(1)=0.008
      l_sand2D_n(1)=.FALSE.
      l_outsandrouse_n(1)=.FALSE. 
    name_var_n(2)='SAND'
      long_name_var_n(2)='SAND'
      standard_name_var_n(2)='SAND'
      unit_var_n(2)='kg.m-3'
      flx_atm_n(2)=0.0
      cv_rain_n(2)=0.0
      cini_wat_n(2)=0.0
      cini_sed_n(2)=0.2
      cini_air_n(2)=0.0
      l_out_subs_n(2)=.TRUE.
      l_bedload_n(2)=.FALSE.
      init_cv_name_n(2)='SAND'
      obc_cv_name_n(2)='none'
      tocd_n(2)=1000.
      ros_n(2)=2600.0
      diam_n(2)=0.0002
      l_sand2D_n(2)=.FALSE.
      l_outsandrouse_n(2)=.FALSE.  /
:-----------------------------------------------------------------------------    
: nmlmuds : Characterization of MUD substances (used only if defined MUSTANG)
:           If nv_mud = 0 this namelist is not read
:-----------------------------------------------------------------------------
:    name_var_n() : string, name of variable
:    long_name_var_n() : string, long name of variable
:    standard_name_var_n() : string, standard name of variable
:    unit_var_n() : string, unit of concentration of variable
:    flx_atm_n() : real, uniform atmospherical deposition (unit/m2/s) 
:    cv_rain_n() : real, concentration in rainwater (unit/m3 of water)
:    cini_wat_n() : real, initial concentration in water column (unit/m3)
:    cini_air_n() : real, initial concentration in air
:    l_out_subs_n() : boolean, saving in output file if TRUE
:    init_cv_name_n() : string, name of substance read from initial condition
:                       file, falling back to its uniform cini_wat_n()
:                       concentration if 'none' or if the variable is not
:                       found. Special value: 'none' skips reading an
:                       initial-file variable for this substance. Left
:                       empty (''), it defaults to name_var_n() (i.e. the
:                       variable is read if present in the init file, same
:                       name as the substance itself)
:    obc_cv_name_n() : string, name of substance read from obc file,
:                       falling back to its uniform cobc_wat_n()
:                       concentration if 'none' or if the variable is not
:                       found. Special values: 'none' skips reading a
:                       bry-file variable for this substance.
:                       'nullGradient' imposes a plain zero-gradient
:                       (Neumann) condition instead (no bry-file value, no
:                       cobc_wat_n()). Left empty (''), it defaults to
:                       name_var_n() (i.e. the variable is read if present
:                       in the bry file, same name as the substance itself)
:    cini_sed_n() : real, initial concentration in sediment (quantity/kg of 
:                   dry sediment)  (only if cppkey MUSTANG)
:    cobc_wat_n() : real, boundaries uniform and constant concentration 
:                   (kg/m3)
:    tocd_n() : real, critical stress of deposition (N/m2) 
:    ros_n()  : real, density of particle (kg/m3)
:    ws_free_opt_n() : integer, choice of free settling formulation : 
:                      0 constant, 1 Van Leussen, 2 Winterwerp, 3 Wolanski
:    ws_free_min_n() : real, minimum setling velocity (m/s)
:    ws_free_max_n() : real, maximum setling velocity (m/s)
:    ws_free_para_n(1:4,num substance) : 4 additional parameters
:    ws_hind_opt_n() : choice of hindered settling formulation : 
:                      0 no hindered settling, 1 Scott, 2 Winterwerp, 
:                      3 Wolanski
:    ws_hind_para_n(1:2,num substance) : 2 additional parameters 
:
 &nmlmuds
    name_var_n(1)='MUD1'
      long_name_var_n(1)='MUD1'
      standard_name_var_n(1)='MUD1'
      unit_var_n(1)='kg.m-3'
      flx_atm_n(1)=0.0
      cv_rain_n(1)=0.0
      cini_wat_n(1)=0.0
      cobc_wat_n(1)=0.0
      cini_sed_n(1)=0.6
      cini_air_n(1)=0.0
      l_out_subs_n(1)=.TRUE.
      init_cv_name_n(1)='MUD1'
      obc_cv_name_n(1)='nullGradient'
      tocd_n(1)=1000.
      diam_n(1)=0.
      ros_n(1)=2600.0
      ws_free_opt_n(1)=1
      ws_free_min_n(1)=0.00002
      ws_free_max_n(1)=0.004
      ws_free_para_n(1,1)=0.005,  ws_free_para_n(2,1)=0.7, ws_free_para_n(3,1)=0.3, ws_free_para_n(4,1)=0.09
      ws_hind_opt_n(1)=0
      ws_hind_para_n(1,1)=0.0 ,  ws_hind_para_n(2,1)=0.0 /
:-----------------------------------------------------------------------------
: nmlvardiss : DISSOLVED SUBSTANCES
:              If nv_dis = 0 this namelist is not read
:-----------------------------------------------------------------------------
: 3 diagnostic dissolved tracers added to isolate, one at a time, the new
: boundary/initial-condition fallback logic and the new T90/flx_atm/cv_rain
: source terms (#590). None of them represents a real compound.
:    DIAG_T90  : initialised uniformly to 1. everywhere (init_cv_name_n=
:                'none' skips reading an init-file variable), zero-gradient
:                OBC (obc_cv_name_n='nullGradient', so advection/diffusion
:                through the open boundaries cannot replenish it), no
:                atmospheric/rain source: the only way its concentration can
:                change is the t90_n=24h decay, so its field after a few
:                days directly shows the T90 exponential die-off.
:    DIAG_ATM  : initialised to 0. everywhere, 0. at the open boundaries
:                (init_cv_name_n/obc_cv_name_n left to 'none', falling back
:                to cini_wat_n=0./cobc_wat_n=0.), so the only possible
:                source is the uniform dry atmospheric deposition
:                flx_atm_n(): any concentration appearing in the water
:                column over the run comes from that flux alone.
:    DIAG_RAIN : same zero init/obc as DIAG_ATM, but the source is the
:                wet-deposition term cv_rain_n() (concentration in
:                rainwater), active only where/when it is raining
:                (needs CPP key RAIN_FLUX): any concentration appearing
:                tracks the precipitation forcing instead of being uniform
:                like DIAG_ATM.
:
 &nmlvardiss
    name_var_n(1)='DIAG_T90'
      long_name_var_n(1)='T90 decay test tracer'
      standard_name_var_n(1)='DIAG_T90'
      unit_var_n(1)='-'
      flx_atm_n(1)=0.0
      cv_rain_n(1)=0.0
      t90_n(1)=24.0
      cini_wat_n(1)=1.0
      cobc_wat_n(1)=1.0
      cini_sed_n(1)=0.0
      cini_air_n(1)=0.0
      l_out_subs_n(1)=.TRUE.
      init_cv_name_n(1)='none'
      obc_cv_name_n(1)='nullGradient'
    name_var_n(2)='DIAG_ATM'
      long_name_var_n(2)='flx_atm dry-deposition test tracer'
      standard_name_var_n(2)='DIAG_ATM'
      unit_var_n(2)='-'
      flx_atm_n(2)=1.0e-6
      cv_rain_n(2)=0.0
      t90_n(2)=0.0
      cini_wat_n(2)=0.0
      cobc_wat_n(2)=0.0
      cini_sed_n(2)=0.0
      cini_air_n(2)=0.0
      l_out_subs_n(2)=.TRUE.
      init_cv_name_n(2)='none'
      obc_cv_name_n(2)='none'
    name_var_n(3)='DIAG_RAIN'
      long_name_var_n(3)='cv_rain wet-deposition test tracer'
      standard_name_var_n(3)='DIAG_RAIN'
      unit_var_n(3)='-'
      flx_atm_n(3)=0.0
      cv_rain_n(3)=10.0
      t90_n(3)=0.0
      cini_wat_n(3)=0.0
      cobc_wat_n(3)=0.0
      cini_sed_n(3)=0.0
      cini_air_n(3)=0.0
      l_out_subs_n(3)=.TRUE.
      init_cv_name_n(3)='none'
      obc_cv_name_n(3)='none' /

