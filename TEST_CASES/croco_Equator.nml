&croco_title
  title = "Equator Example"
/

&croco_time_stepping
  ntimes = 3600
  dt = 8640
  ndtfast = 45
  ninfo = 1
/

&croco_s_coord
  theta_s = 5.0d0
  theta_b = 0.0d0
  Tcline = 10.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 30
  nrpfhis = 0
  hisname = "equator_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "equator_ini.nc"
/

&croco_restart
  nrst = 3600
  nrpfrst = -1
  rstname = "equator_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 2.0e3
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*1.0e3
/


! End of namelist
