&croco_title
  title = "IGW TEST MODEL"
/

&croco_time_stepping
  ntimes = 5
  dt = 30.
  ndtfast = 60
  ninfo = 500
/

&croco_time_stepping_nbq
  ndtnbq = 10
  csound_nbq = 1500
  visc2_nbq = 1.
/

&croco_s_coord
  theta_s = 1
  theta_b = 0
  Tcline = 1.e3
/

&croco_history
  ldefhis = .true.
  nwrt = 5
  nrpfhis = 0
  hisname = "igw_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "igw_ini.nc"
/

&croco_restart
  nrst = 5
  nrpfrst = -1
  rstname = "igw_rst.nc"
/

&croco_grid
  grdname = "TEST_CASES/igw_grd.nc"
/

&croco_forcing
  frcname = "TEST_CASES/igw_frc.nc"
/

&croco_climatology
  clmname = "TEST_CASES/igw_clm.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1027.d0
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 1.e-3
  Cdb_min = 1.e-4
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.1
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_tracer_diff4
  tnu4 = 1*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.d-05
  Akt_bak = 1*1.d-05
/

&croco_averages
  ntsavg = 1
  navg = 259200
  nrpfavg = 0
  avgname = "igw_avg.nc"
/


! End of namelist
