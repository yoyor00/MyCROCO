&croco_title
  title = "Vortex Example"
/

&croco_time_stepping
  ntimes = 600
  dt = 2880
  ndtfast = 50
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 200
  visc2_nbq = 1.
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 5000.0d0
/

&croco_history
  ldefhis = .true.
  nwrt = 60
  nrpfhis = 0
  hisname = "vortex_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/VORTEX/vortex_ini.nc"
/

&croco_restart
  nrst = 600
  nrpfrst = -1
  rstname = "TEST_CASES/VORTEX/vortex_rst.nc"
/

&croco_grid
  grdname = "TEST_CASES/VORTEX/vortex_grd.nc"
/

&croco_sponge
  x_sponge = 150.e3
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 1.
  tauM_out = 360.
/

&croco_climatology
  clmname = "TEST_CASES/VORTEX/vortex_clm.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 1*0.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  his_rho = .true.
  his_omega = .true.
  his_w = .true.
  his_akv = .false.
  his_bostr = .false.
  his_bustr = .false.
  his_bvstr = .false.
  his_wstr = .false.
  his_ustr = .false.
  his_vstr = .false.
/

&croco_temperature_history_fields
  his_akt = .true.
  his_shflx = .false.
  his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  his_aks = .false.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .false.
  his_shflx_lat = .false.
  his_shflx_sen = .false.
/

&croco_hbl_history_fields
  his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .false.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .false.
/

&croco_morphodyn_history_fields
  his_hm = .false.
/


! End of namelist
