&croco_title
  title = "Vortex Example (DON'T FORGET make_vortex.m)"
/

&croco_time_stepping
  ntimes = 600
  dt = 2880
  ndtfast = 50
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  hc = 5000.0d0
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/VORTEX/vortex_ini.nc"
/

&croco_grid
  grdname = "TEST_CASES/VORTEX/vortex_grd.nc"
/

&croco_climatology
  clmname = "TEST_CASES/VORTEX/vortex_clm.nc"
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 1.
  tauM_out = 360.
/

&croco_history
  ldefhis = .true.
  nwrt = 60
  nrpfhis = 0
  hisname = "vortex_his.nc"
/

&croco_restart
  nrst = 600
  nrpfrst = -1
  rstname = "TEST_CASES/VORTEX/vortex_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 1*0.
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .true.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/



! End of namelist
