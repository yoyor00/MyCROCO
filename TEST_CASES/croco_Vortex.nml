&croco_title
  title = "Vortex Example (DON'T FORGET make_vortex.m)"
/

&croco_time_stepping
  ntimes = 600
  dt = 2880
  ndtfast = 50
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 200
  visc2_nbq = 1.
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 5000.0d0
/

&croco_history
  ldefhis = .true.
  nwrt = 60
  nrpfhis = 0
  hisname = "vortex_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/VORTEX/vortex_ini.nc"
/

&croco_restart
  nrst = 600
  nrpfrst = -1
  rstname = "TEST_CASES/VORTEX/vortex_rst.nc"
/


