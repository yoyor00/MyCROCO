&croco_title
  title = "SCM TEST MODEL"
/

&croco_time_stepping
  ntimes = 8640
  dt = 30
  ndtfast = 60
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.0d16
/

&croco_history
  ldefhis = .true.
  nwrt = 120
  nrpfhis = 0
  hisname = "scm_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 3600
  nrpfrst = -1
  rstname = "scm_rst.nc"
/

&croco_grid
  grdname = "filegrid"
/

&croco_forcing
  frcname = "fileforc"
/

&croco_bulk_forcing
  bulkname = "filebulk"
/

&croco_climatology
  clmname = "fileclim"
/

&croco_biology
  bioname = "CROCO_FILES/croco_frcbio.nc"
/

&croco_boundary
  bry_file = "filebound"
/

&croco_lin_eos
  R0 = 24
  T0 = 16.
  S0 = 0.
  Tcoef = 0.2
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment_flume.in"
/

&croco_rho0
  rho0 = 1024.d0
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_tracer_diff4
  tnu4 = 1*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.d-05
  Akt_bak = 1*1.d-06
/

&croco_averages
  ntsavg = 1
  navg = 120
  nrpfavg = 0
  avgname = "scm_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 72
  nrpfdia = 0
  dianame = "CROCO_FILES/croco_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 72
  nrpfdia_avg = 0
  dianame_avg = "CROCO_FILES/croco_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_diagnosticsM
  ldefdiaM = .true.
  nwrtdiaM = 72
  nrpfdiaM = 0
  dianameM = "CROCO_FILES/croco_diaM.nc"
/

&croco_diagM_avg
  ldefdiaM_avg = .true.
  ntsdiaM_avg = 1
  nwrtdiaM_avg = 72
  nrpfdiaM_avg = 0
  dianameM_avg = "CROCO_FILES/croco_diaM_avg.nc"
/

&croco_diagnostics_bio
  ldefdiabio = .true.
  nwrtdiabio = 72
  nrpfdiabio = 0
  dianamebio = "CROCO_FILES/croco_diabio.nc"
/

&croco_diagbio_avg
  ldefdiabio_avg = .true.
  ntsdiabio_avg = 1
  nwrtdiabio_avg = 72
  nrpfdiabio_avg = 0
