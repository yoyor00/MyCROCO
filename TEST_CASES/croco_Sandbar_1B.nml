&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  Tcline = 2
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_wkb_wwave
  wkb_amp = 0.45
  wkb_ang = 0.0
  wkb_prd = 5.
  wkb_tide = 0.0
  wkb_btg = 0.6
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.15
  wkb_roller = 1.8
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/


! End of namelist
