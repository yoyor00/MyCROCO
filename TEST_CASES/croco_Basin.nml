&croco_title
  title = "Basin Example"
/

&croco_logfile
  logname = "basin.log"
/

&croco_time_stepping
  ntimes = 3240
  dt = 9600
  ndtfast = 65
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 10.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 90
  nrpfhis = 0
  hisname = "basin_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "basin_rst.nc"
/

&croco_restart
  nrst = 20000000
  nrpfrst = -1
  rstname = "basin_rst.nc"
/

&croco_bodyforce
  levsfrc = 10
  levbfrc = 1
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = -1.
/

&croco_lateral_visc
  visc2 = 1000.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1000., 0.
/

&croco_tracer_diff4
  tnu4 = 1*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 1*1.e-6
/

&croco_averages
  ntsavg = 1
  navg = 3240
  nrpfavg = 0
  avgname = "basin_avg.nc"
/


! End of namelist
