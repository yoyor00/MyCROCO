&croco_title
  title = "Basin Example"
/

&croco_logfile
  logname = "basin.log"
/

&croco_time_stepping
  ntimes = 3240
  dt = 9600
  ndtfast = 65
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 10.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 90
  nrpfhis = 0
  hisname = "basin_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "basin_rst.nc"
/

&croco_restart
  nrst = 20000000
  nrpfrst = -1
  rstname = "basin_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 1*.true.
/

&croco_bodyforce
  levsfrc = 10
  levbfrc = 1
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = -1.
/

&croco_lateral_visc
  visc2 = 1000.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*1000.
/

&croco_tracer_diff4
  tnu4 = 1*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 1*1.e-6
/

&croco_averages
  ntsavg = 1
  navg = 3240
  nrpfavg = 0
  avgname = "basin_avg.nc"
/

&croco_diagnosticsM
  ldefdiaM = .true.
  nwrtdiaM = 270
  nrpfdiaM = 0
  dianameM = "basin_diaM.nc"
/

&croco_diagM_avg
  ldefdiaM_avg = .true.
  ntsdiaM_avg = 1
  nwrtdiaM_avg = 0
  nrpfdiaM_avg = 0
  dianameM_avg = "basin_diaM_avg.nc"
/

&croco_diags_vrt
  ldefdiags_vrt = .true.
  nwrtdiags_vrt = 0
  nrpfdiags_vrt = 0
  diags_vrtname = "basin_diags_vrt.nc"
/

&croco_diags_vrt_avg
  ldefdiags_vrt_avg = .true.
  ntsdiags_vrt_avg = 1
  nwrtdiags_vrt_avg = 0
  nrpfdiags_vrt_avg = 0
  diags_vrtname_avg = "basin_diags_vrt_avg.nc"
/

&croco_diags_ek
  ldefdiags_ek = .true.
  nwrtdiags_ek = 0
  nrpfdiags_ek = 0
  diags_ekname = "basin_diags_ek.nc"
/

&croco_diags_ek_avg
  ldefdiags_ek_avg = .true.
  ntsdiags_ek_avg = 1
  nwrtdiags_ek_avg = 0
  nrpfdiags_ek_avg = 0
  diags_ekname_avg = "basin_diags_ek_avg.nc"
/

&croco_diagM_history_fields
  his_diagM_u = .true.
  his_diagM_v = .true.
/

&croco_diagM_average_fields
  avg_diagM_u = .true.
  avg_diagM_v = .true.
/

&croco_diags_vrt_history_fields
  his_diags_vrt = .true.
/

&croco_diags_vrt_average_fields
  avg_diags_vrt = .true.
/

&croco_diags_ek_history_fields
  his_diags_ek = .true.
/

&croco_diags_ek_average_fields
  avg_diags_ek = .true.
/

&croco_stochastic_history_fields
  his_xi2d = .true.
  his_xi3d = .false.
/


! End of namelist
