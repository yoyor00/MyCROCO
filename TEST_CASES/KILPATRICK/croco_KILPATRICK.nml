&croco_testcase
  testcase_name = 'KILPATRICK'
/

&croco_title
  title = "KILPATRICK"
/

&croco_time_stepping
  ntimes = 1296
  dt = 100
  ndtfast = 2
  ninfo = 1
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 2.0d0
  hc = 200.0d0
/

&croco_initial
  nrrec = 0
  ininame = "croco_ini.nc"
/

&croco_history
  ldefhis = .true.
  nwrt = 36
  nrpfhis = 0
  hisname = "croco_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 36
  nrpfavg = 0
  avgname = "croco_avg.nc"
/

&croco_restart
  nrst = 2592
  nrpfrst = -1
  rstname = "croco_rst.nc"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 3.0d-04
  rdrg2 = 0.d-3
  Zobt = 0.d-3
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 1*0.d0
/

&croco_abl
  ldefablhis = .true.
  nwrtablhis = 36
  nrpfablhis = 0
