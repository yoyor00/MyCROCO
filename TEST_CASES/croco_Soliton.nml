&croco_title
  title = "Equatorial Rossby Wave Example"
/

&croco_time_stepping
  ntimes = 1200
  dt = 0.1
  ndtfast = 1
  ninfo = 5
/

&croco_history
  ldefhis = .true.
  nwrt = 80
  nrpfhis = 0
  hisname = "soliton_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "soliton_rst.nc"
/

&croco_restart
  nrst = 1200
  nrpfrst = -1
  rstname = "soliton_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_averages
  ntsavg = 1
  navg = 80
  nrpfavg = 0
  avgname = "soliton_avg.nc"
/


! End of namelist
