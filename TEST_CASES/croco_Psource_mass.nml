&croco_title
  title = "River run off  Example"
/

&croco_time_stepping
  ntimes = 800
  dt = 540
  ndtfast = 60
  ninfo = 1
/

&croco_s_coord
  theta_s = 3.0d0
  theta_b = 0.0d0
  Tcline = 50.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 40
  nrpfhis = 0
  hisname = "river_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "river_rst.nc"
/

&croco_restart
  nrst = 800
  nrpfrst = -1
  rstname = "river_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = -1.
  Scoef = 0.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 3.0E-04
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = -1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 2*1.e-6
/


! End of namelist
