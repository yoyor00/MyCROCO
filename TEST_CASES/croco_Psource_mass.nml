&croco_title
  title = "River run off  Example"
/

&croco_time_stepping
  ntimes = 800
  dt = 540
  ndtfast = 60
  ninfo = 1
/

&croco_s_coord
  theta_s = 3.0d0
  theta_b = 0.0d0
  Tcline = 50.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 40
  nrpfhis = 0
  hisname = "river_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "river_rst.nc"
/

&croco_restart
  nrst = 800
  nrpfrst = -1
  rstname = "river_rst.nc"
/

&croco_sponge
  x_sponge = 150.e3
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = -1.
  Scoef = 0.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 3.0E-04
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = -1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 2*1.e-6
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  his_rho = .true.
  his_omega = .false.
  his_w = .true.
  his_akv = .false.
  his_bostr = .false.
  his_bustr = .true.
  his_bvstr = .true.
  his_wstr = .false.
  his_ustr = .false.
  his_vstr = .false.
/

&croco_temperature_history_fields
  his_akt = .true.
  his_shflx = .false.
  his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  his_aks = .false.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .false.
  his_shflx_lat = .false.
  his_shflx_sen = .false.
/

&croco_hbl_history_fields
  his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .false.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .false.
/

&croco_morphodyn_history_fields
  his_hm = .false.
/

&croco_psource
  psource_Nsrc = 2
/

&croco_psource_data
  psource_Isrc(   1) =     3, psource_Jsrc(   1) =    54, psource_Dsrc(   1) =     1, psource_Qbar(   1) =  200.
  psource_Isrc(   2) =     3, psource_Jsrc(   2) =    40, psource_Dsrc(   2) =     0, psource_Qbar(   2) =  200.
/

&croco_psource_tracer
  psource_Lsrc(1,1) = T
  psource_Lsrc(1,2) = T
  psource_Lsrc(2,1) = T
  psource_Lsrc(2,2) = T
  psource_Tsrc0(1,1) = 5.
  psource_Tsrc0(1,2) = 0.
  psource_Tsrc0(2,1) = 5.
  psource_Tsrc0(2,2) = 0.
/


! End of namelist
