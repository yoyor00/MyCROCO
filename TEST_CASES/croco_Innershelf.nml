&croco_title
  title = "Inner Shelf 2D-V Example (Homogeneous case)"
/

&croco_time_stepping
  ntimes = 5760
  dt = 300
  ndtfast = 50
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.001d0
  theta_b = 1.0d0
  Tcline = 4.9d0
/

&croco_history
  ldefhis = .true.
  nwrt = 5760
  nrpfhis = 0
  hisname = "innershelf_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "innershelf_rst.nc"
/

&croco_restart
  nrst = 5760
  nrpfrst = -1
  rstname = "innershelf_rst.nc"
/

&croco_sponge
  x_sponge = 40.e3
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 1*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 20.
  S0 = 35.
  Tcoef = 0.28d0
  Scoef = 0.78d0
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 5.E-03
  rdrg2 = 0.
  Zobt = 0.e-2
  Cdb_min = 5.e-3
  Cdb_max = 100.e-3
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-2
  Akt_bak = 1*5.e-3
/

&croco_averages
  ntsavg = 1
  navg = 576
  nrpfavg = 0
  avgname = "innershelf_avg.nc"
/

&croco_stations
  ldefsta = .true.
  nsta = 24
  nrpfsta = 0
  staposname = "stations.in"
  staname = "stations.nc"
/

&croco_diagnostics_ts
  ldefdia = .false.
  nwrtdia = 5760
  nrpfdia = -1
  dianame = "croco_diags.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 576
  nrpfdia_avg = 0
  dianame_avg = "croco_diags_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_station_fields
  sta_grd = .true.
  sta_temp = .true.
  sta_salt = .false.
  sta_rho = .false.
  sta_vel = .true.
/


! End of namelist
