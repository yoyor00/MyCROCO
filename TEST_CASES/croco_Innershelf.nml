&croco_title
  title = "Inner Shelf 2D-V Example (Homogeneous case)"
/

&croco_time_stepping
  ntimes = 5760
  dt = 300
  ndtfast = 50
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.001d0
  theta_b = 1.0d0
  Tcline = 4.9d0
/

&croco_initial
  nrrec = 0
  ininame = "innershelf_rst.nc"
/

&croco_sponge
  x_sponge = 40.e3
/

&croco_history
  ldefhis = .true.
  nwrt = 5760
  nrpfhis = 0
  hisname = "innershelf_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 576
  nrpfavg = 0
  avgname = "innershelf_avg.nc"
/

&croco_restart
  nrst = 5760
  nrpfrst = -1
  rstname = "innershelf_rst.nc"
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 5.E-03
  rdrg2 = 0.
  Zobt = 0.e-2
  Cdb_min = 5.e-3
  Cdb_max = 100.e-3
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-2
  Akt_bak = 1*5.e-3
/

&croco_lin_eos
  R0 = 30.
  T0 = 20.
  S0 = 35.
  Tcoef = 0.28d0
  Scoef = 0.78d0
/

&croco_diagnostics_ts
  ldefdia = .false.
  nwrtdia = 5760
  nrpfdia = -1
  dianame = "croco_diags.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 576
  nrpfdia_avg = 0
  dianame_avg = "croco_diags_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_stations
  ldefsta = .true.
  nsta = 24
  nrpfsta = 0
  staposname = "stations.in"
  staname = "stations.nc"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 1*.true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .true.
  out_avg_omega = .false.
  out_avg_w = .true.
  out_avg_akv = .false.
  out_avg_bostr = .false.
  out_avg_bustr = .false.
  out_avg_bvstr = .false.
  out_avg_wstr = .false.
  out_avg_ustr = .false.
  out_avg_vstr = .false.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .false.
  out_avg_shflx_rsw = .false.
/

&croco_salinity_averages_fields
  out_avg_aks = .false.
/

&croco_bulk_flux_averages_fields
  out_avg_shflx_rlw = .false.
  out_avg_shflx_lat = .false.
  out_avg_shflx_sen = .false.
/

&croco_hbl_averages_fields
  out_avg_hbl = .false.
/

&croco_lmd_bkpp_averages_fields
  out_avg_hbbl = .false.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  out_avg_diff3d = .false.
/

&croco_biology_averages_fields
  out_avg_hel = .false.
/

&croco_morphodyn_averages_fields
  out_avg_hm = .false.
/

&croco_station_fields
  sta_grd = .true.
  sta_temp = .true.
  sta_salt = .false.
  sta_rho = .false.
  sta_vel = .true.
/


! End of namelist
