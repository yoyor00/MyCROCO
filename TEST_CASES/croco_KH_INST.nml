&croco_title
  title = "Kelvin-Helmoltz instability Example"
/

&croco_time_stepping
  ntimes = 1600
  dt = 0.3
  ndtfast = 20
  ninfo = 50
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10
  visc2_nbq = 1.e2
/

&croco_s_coord
  theta_s = 0
  theta_b = 0
  Tcline = 1.e16
/

&croco_initial
  nrrec = 0
  ininame = "khinst_rst.nc"
/

&croco_history
  ldefhis = .true.
  nwrt = 400
  nrpfhis = 0
  hisname = "khinst_his.nc"
/

&croco_restart
  nrst = 1600
  nrpfrst = -1
  rstname = "khinst_rst.nc"
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 1.e-6
  visc4 = 1.e-6
/

&croco_tracer_diff2
  tnu2 = 1*1.e-6
/

&croco_vertical_mixing
  Akv_bak = 1.e-6
  Akt_bak = 1*1.e-6
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 1.
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .false.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .false.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .true.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/



! End of namelist
