&croco_title
  title = "Kelvin-Helmoltz instability Example"
/

&croco_time_stepping
  ntimes = 1600
  dt = 0.3
  ndtfast = 20
  ninfo = 50
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10
  visc2_nbq = 1.e2
/

&croco_s_coord
  theta_s = 0
  theta_b = 0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 400
  nrpfhis = 0
  hisname = "khinst_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "khinst_rst.nc"
/

&croco_restart
  nrst = 1600
  nrpfrst = -1
  rstname = "khinst_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 1.
  Scoef = 0.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 1.e-6
  visc4 = 1.e-6
/

&croco_tracer_diff2
  tnu2 = 1*1.e-6
/

&croco_vertical_mixing
  Akv_bak = 1.e-6
  Akt_bak = 1*1.e-6
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .false.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .false.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  his_rho = .true.
  his_omega = .true.
  his_w = .true.
  his_akv = .false.
  his_bostr = .false.
  his_bustr = .false.
  his_bvstr = .false.
  his_wstr = .false.
  his_ustr = .false.
  his_vstr = .false.
/

&croco_temperature_history_fields
  his_akt = .false.
  his_shflx = .false.
  his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  his_aks = .false.
  his_swflx = .false.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .false.
  his_shflx_lat = .false.
  his_shflx_sen = .false.
/

&croco_bvf_history_fields
  his_bvf = .false.
/

&croco_hbl_history_fields
  his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .false.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .false.
/


! End of namelist
