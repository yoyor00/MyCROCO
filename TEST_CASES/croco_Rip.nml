&croco_title
  title = "RIP Example"
/

&croco_time_stepping
  ntimes = 1800
  dt = 4
  ndtfast = 20
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 300
  nrpfhis = 0
  hisname = "rip_his.nc"
/

&croco_initial
  nrrec = 0
/

&croco_restart
  nrst = 1800
  nrpfrst = -1
  rstname = "rip_rst.nc"
/

&croco_grid
  grdname = "rip_grd.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 30.
  tauM_in = 0.1
  tauM_out = 100.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 1*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.0e-04
  rdrg2 = 0.0e-3
  Zobt = 1.e-3
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-5
  Akt_bak = 1*1.e-5
/

&croco_wkb_wwave
  wkb_amp = 0.5
  wkb_ang = 0.
  wkb_prd = 10.
  wkb_tide = 0.0
  wkb_btg = 1.3
  wkb_gam = 0.38
/

&croco_wkb_roller
  wkb_rsb = 0.1
  wkb_roller = 0.5
/

&croco_wave_maker
  wmaker_amp = 0.4
  wmaker_prd = 11.0
  wmaker_dir = -10.0
  wmaker_dsp = 30.0
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 1800
  nrpfavg = 0
  avgname = "rip_avg.nc"
/

&croco_diagnosticsM
  ldefdiaM = .true.
  nwrtdiaM = 300
  nrpfdiaM = -1
  dianameM = "rip_diaM.nc"
/

&croco_diagM_history_fields
  his_diagM_u = .true.
  his_diagM_v = .true.
/

&croco_bbl_history_fields
  his_abed = .false.
  his_hripple = .false.
  his_lripple = .false.
  his_zbnot = .true.
  his_zbapp = .true.
  his_bostrw = .true.
/

&croco_wci_history_fields
  his_sup = .true.
  his_ust2d = .true.
  his_vst2d = .true.
/

&croco_wci_history_3d_fields
  his_ust = .true.
  his_vst = .true.
  his_wst = .true.
  his_akb = .true.
  his_akw = .true.
  his_kvf = .true.
  his_calp = .true.
  his_kaps = .true.
/

&croco_wave_history_fields
  his_hrm = .true.
  his_frq = .true.
  his_action = .true.
  his_k_xi = .true.
  his_k_eta = .true.
  his_eps_b = .true.
  his_eps_d = .true.
  his_erol = .true.
  his_eps_r = .true.
/


! End of namelist
