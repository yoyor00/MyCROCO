&croco_testcase
  testcase_name = 'SED_TOY_RESUSP'
/

&croco_title
  title = "SED TOY Mixed bed (erosion and sediment resuspension) TEST MODEL"
/

&croco_time_stepping
  ntimes = 216000
  dt = 2.
  ndtfast = 20
  ninfo = 40
/

&croco_s_coord
  theta_s = 1.0
  theta_b = 0.8
  hc = 0.
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_history
  ldefhis = .true.
  nwrt = 3600
  nrpfhis = 0
  hisname = "sed_toy_resusp_his.nc"
/

&croco_restart
  nrst = 216000
  nrpfrst = -1
  rstname = "sed_toy_resusp_rst.nc"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 3.0d-04
  rdrg2 = 3.0d-03
  Zobt = 0.0005
  Cdb_min = 1.d-6
  Cdb_max = 5.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 6*0.d0
/

&croco_tracer_diff4
  tnu4 = 6*0.d11
/

&croco_lin_eos
  R0 = 27
  T0 = 10.
  S0 = 35.
  Tcoef = 1.7d-4
  Scoef = 7.6d-4
/

&croco_sediments
  sedname = "TEST_CASES/SED_TOY/sediment_sed_toy_resusp.in"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 6*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .true.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  out_his_aks = .true.
  out_his_swflx = .true.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .true.
  out_his_sed_bthk = .true.
  out_his_sed_bpor = .true.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 4*.true.
/

&croco_sediment_suspload_history_fields
  out_his_sed_dflx = 4*.true.
  out_his_sed_eflx = 4*.true.
/

&croco_sediment_cohesive_history_fields
  out_his_sed_btcr = .true.
/



! End of namelist
