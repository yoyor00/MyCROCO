&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 72000
  dt = 0.05
  ndtfast = 10
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 2.0d0
  Tcline = 10
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_ini.nc"
/

&croco_restart
  nrst = 180000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 0.1
  tauT_out = 0.1
  tauM_in = 0.1
  tauM_out = 0.1
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment_sandbar_1B.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 1*0.
/

&croco_wave_maker
  wmaker_amp = 0.21
  wmaker_prd = 8.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 300
  nrpfdia = 0
  dianame = "sandbar_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 250
  nrpfdia_avg = 0
  dianame_avg = "sandbar_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/
&croco_diags_eddy_avg
  ldefdiags_eddy_avg = .true.
  ntsdiags_eddy_avg = 1
  nwrtdiags_eddy_avg = 6000
  nrpfdiags_eddy_avg = 0
  diags_eddyname_avg = "sandbar_diags_eddy_avg.nc"
/

&croco_gls_history_fields
  his_tke = .true.
  his_gls = .true.
  his_lscale = .true.
/

&croco_gls_averages_fields
  avg_tke = .true.
  avg_gls = .true.
  avg_lscale = .true.
/

&croco_bbl_history_fields
  his_abed = .false.
  his_hripple = .false.
  his_lripple = .false.
  his_zbnot = .false.
  his_zbapp = .false.
  his_bostrw = .false.
/

&croco_wci_history_fields
  his_sup = .true.
  his_ust2d = .true.
  his_vst2d = .true.
/

&croco_wci_history_3d_fields
  his_ust = .true.
  his_vst = .true.
  his_wst = .true.
  his_akb = .true.
  his_akw = .true.
  his_kvf = .true.
  his_calp = .true.
  his_kaps = .true.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  his_rho = .false.
  his_omega = .false.
  his_w = .true.
  his_akv = .true.
  his_bostr = .true.
  his_wstr = .true.
  his_ustr = .true.
  his_vstr = .true.
/

&croco_temperature_history_fields
  his_akt = .false.
  his_shflx = .true.
  his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  his_aks = .false.
  his_swflx = .true.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .true.
  his_shflx_lat = .true.
  his_shflx_sen = .true.
/

&croco_hbl_history_fields
  his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .true.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .true.
/

&croco_auxiliary_averages_fields
  avg_rho = .false.
  avg_omega = .false.
  avg_w = .true.
  avg_akv = .true.
  avg_bostr = .true.
  avg_wstr = .true.
  avg_ustr = .true.
  avg_vstr = .true.
/

&croco_temperature_averages_fields
  avg_akt = .false.
  avg_shflx = .true.
  avg_shflx_rsw = .true.
/

&croco_salinity_averages_fields
  avg_aks = .false.
  avg_swflx = .true.
/

&croco_bulk_flux_averages_fields
  avg_shflx_rlw = .true.
  avg_shflx_lat = .true.
  avg_shflx_sen = .true.
/

&croco_hbl_averages_fields
  avg_hbl = .true.
/

&croco_lmd_bkpp_averages_fields
  avg_hbbl = .true.
/

&croco_vis_coef_averages_fields
  avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  avg_diff3d = .false.
/

&croco_biology_averages_fields
  avg_hel = .true.
/

&croco_diag3D_history_fields
  his_dia3D_tracer = 1*.true.
/

&croco_diag2D_history_fields
  his_dia2D_tracer = 1*.true.
/

&croco_diag3D_average_fields
  avg_dia3D_tracer = 1*.true.
/

&croco_diag2D_average_fields
  avg_dia2D_tracer = 1*.true.
/

&croco_diags_eddy_history_fields
  his_diags_eddy = .false.
/

&croco_diags_eddy_average_fields
  avg_diags_eddy = .true.
/


! End of namelist
