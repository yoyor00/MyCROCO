&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 72000
  dt = 0.05
  ndtfast = 10
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 2.0d0
  Tcline = 10
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_ini.nc"
/

&croco_restart
  nrst = 180000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment_sandbar_1B.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 1*0.
/

&croco_wave_maker
  wmaker_amp = 0.21
  wmaker_prd = 8.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/


! End of namelist
