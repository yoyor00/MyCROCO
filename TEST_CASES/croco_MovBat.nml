&croco_title
  title = "Tank Example"
/

&croco_time_stepping
  ntimes = 50250
  dt = 0.002
  ndtfast = 5
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10.
  visc2_nbq = 0.
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 1005
  nrpfhis = 0
  hisname = "movbat_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "movbat_rst.nc"
/

&croco_restart
  nrst = 1000000
  nrpfrst = -1
  rstname = "movbat_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_lin_eos
  R0 = 0.
  T0 = 0.
  S0 = 0.
  Tcoef = -1.
  Scoef = 0.
/

&croco_rho0
  rho0 = 1029
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_vertical_mixing
  Akv_bak = 1.e-6
  Akt_bak = 1*1.e-9
/


! End of namelist
