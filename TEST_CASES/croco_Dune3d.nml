&croco_title
  title = "Dune3D test case (Dhysed Bosse / Mustang sediment model)"
/

&croco_time_stepping
  ntimes = 172800
  dt = 1.
  ndtfast = 20
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 10000.0d0
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-03 00:00:00"
  dt_his = 24
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 86400
  nrpfhis = 0
  hisname = "dune3d_his.nc"
/

&croco_initial
  nrrec = 0
/

&croco_restart
  nrst = 1728000
  nrpfrst = -1
  rstname = "dune3d_rst.nc"
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 30.
  tauM_in = 0.1
  tauM_out = 100.
/

&croco_lin_eos
  R0 = 26.65
  T0 = 10.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_dune.in"
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV2_Dune.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_Dune.txt"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 1.d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_gls_history_fields
  his_tke = .true.
  his_gls = .true.
  his_lscale = .true.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 3*.true.
/

&croco_auxiliary_history_fields
  his_rho = .false.
  his_omega = .false.
  his_w = .true.
  his_akv = .false.
  his_bostr = .true.
  his_wstr = .true.
  his_ustr = .true.
  his_vstr = .true.
/

&croco_temperature_history_fields
  his_akt = .true.
  his_shflx = .true.
  his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  his_aks = .false.
  his_swflx = .true.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .true.
  his_shflx_lat = .true.
  his_shflx_sen = .true.
/

&croco_hbl_history_fields
  his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .true.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .true.
/


! End of namelist
