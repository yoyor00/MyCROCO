&croco_title
  title = "TS_adv_body Example"
/

&croco_time_stepping
  ntimes = 750
  dt = 4
  ndtfast = 1
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 300000000.
/

&croco_history
  ldefhis = .true.
  nwrt = 10
  nrpfhis = 0
  hisname = "croco_his_diag_adv.nc"
/

&croco_initial
  nrrec = 0
  ininame = "croco_ini_diag_adv.nc"
/

&croco_restart
  nrst = 720
  nrpfrst = -1
  rstname = "croco_rst_diag_adv.nc"
/

&croco_lin_eos
  R0 = 0.
  T0 = 16.
  S0 = 0.
  Tcoef = 0.2048
  Scoef = 0.
/

&croco_rho0
  rho0 = 1024.d0
/

&croco_bottom_drag
  rdrg = 0.0d-04
  rdrg2 = 0.d-3
  Zobt = 0.d-3
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_tracer_diff4
  tnu4 = 2*0.d11
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 2*0.d0
/

&croco_averages
  ntsavg = 1
  navg = 10
  nrpfavg = 0
  avgname = "croco_avg_diag_adv.nc"
/

&croco_primary_history_fields
  his_zeta = .false.
  his_ubar = .false.
  his_vbar = .false.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_primary_average_fields
  avg_zeta = .false.
  avg_ubar = .false.
  avg_vbar = .false.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  his_rho = .false.
  his_omega = .false.
  his_w = .false.
  his_akv = .false.
  his_bostr = .false.
  his_bustr = .false.
  his_bvstr = .false.
  his_wstr = .false.
  his_ustr = .false.
  his_vstr = .false.
/

&croco_temperature_history_fields
  his_akt = .false.
  his_shflx = .false.
  his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  his_aks = .false.
  his_swflx = .false.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .false.
  his_shflx_lat = .false.
  his_shflx_sen = .false.
/

&croco_hbl_history_fields
  his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .false.
/

&croco_vis_coef_history_fields
  his_visc3d = .false.
/

&croco_dif_coef_history_fields
  his_diff3d = .false.
/

&croco_biology_history_fields
  his_hel = .false.
/

&croco_auxiliary_averages_fields
  avg_rho = .false.
  avg_omega = .false.
  avg_w = .false.
  avg_akv = .false.
  avg_bostr = .false.
  avg_bustr = .false.
  avg_bvstr = .false.
  avg_wstr = .false.
  avg_ustr = .false.
  avg_vstr = .false.
/

&croco_temperature_averages_fields
  avg_akt = .false.
  avg_shflx = .false.
  avg_shflx_rsw = .false.
/

&croco_salinity_averages_fields
  avg_aks = .false.
  avg_swflx = .false.
/

&croco_bulk_flux_averages_fields
  avg_shflx_rlw = .false.
  avg_shflx_lat = .false.
  avg_shflx_sen = .false.
/

&croco_hbl_averages_fields
  avg_hbl = .false.
/

&croco_lmd_bkpp_averages_fields
  avg_hbbl = .false.
/

&croco_vis_coef_averages_fields
  avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  avg_diff3d = .false.
/

&croco_biology_averages_fields
  avg_hel = .false.
/


! End of namelist
