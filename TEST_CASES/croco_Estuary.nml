&croco_title
  title = "Estuary TEST MODEL"
/

&croco_time_stepping
  ntimes = 8640
  dt = 5
  ndtfast = 5
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 500.0d0
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-02 00:00:00"
  dt_his = 1
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 100
  nrpfhis = 0
  hisname = "estuary_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 720000
  nrpfrst = -1
  rstname = "estuary_rst.nc"
/

&croco_lin_eos
  R0 = 30.d0
  T0 = 20.d0
  S0 = 35.5d0
  Tcoef = 0.0d-10
  Scoef = 0.0d-10
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_estuary.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_estuary.txt"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-03
  rdrg2 = 0.0d-3
  Zobt = 1.0d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 1.27
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 4*0.d0
/


