&croco_title
  title = "Estuary TEST MODEL"
/

&croco_time_stepping
  ntimes = 8640
  dt = 5
  ndtfast = 5
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 500.0d0
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-02 00:00:00"
  dt_his = 1
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 100
  nrpfhis = 0
  hisname = "estuary_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 720000
  nrpfrst = -1
  rstname = "estuary_rst.nc"
/

&croco_sponge
  x_sponge = 1000.
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_lin_eos
  R0 = 30.d0
  T0 = 20.d0
  S0 = 35.5d0
  Tcoef = 0.0d-10
  Scoef = 0.0d-10
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_estuary.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_estuary.txt"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-03
  rdrg2 = 0.0d-3
  Zobt = 1.0d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 1.27
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 4*0.d0
/

&croco_gls_history_fields
  out_his_tke = .false.
  out_his_gls = .false.
  out_his_lscale = .false.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 4*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
  out_his_swflx = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .true.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .true.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .true.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_psource
  psource_Nsrc = 1
/

&croco_psource_data
  psource_Isrc(   1) =   200, psource_Jsrc(   1) =    45, psource_Dsrc(   1) =     0, psource_Qbar(   1) = -400.
/

&croco_psource_tracer
  psource_Lsrc(1,1) = T
  psource_Lsrc(1,2) = T
  psource_Lsrc(1,3) = T
  psource_Lsrc(1,4) = T
  psource_Tsrc0(1,1) = 10.
  psource_Tsrc0(1,2) = 0.
  psource_Tsrc0(1,3) = 0.
  psource_Tsrc0(1,4) = 0.05
/


! End of namelist
