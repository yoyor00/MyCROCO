&croco_title
  title = "JET Example (use make_jet.m for non ANA_JET config)"
/

&croco_time_stepping
  ntimes = 4860
  dt = 3200
  ndtfast = 80
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 100
/

&croco_s_coord
  theta_s = 5.0d0
  theta_b = 0.0d0
  Tcline = 100.0d0
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/xxxxx"
/

&croco_grid
  grdname = "TEST_CASES/xxxxx"
/

&croco_climatology
  clmname = "TEST_CASES/xxxxx"
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 50.
  tauM_in = 1.
  tauM_out = 50.
/

&croco_history
  ldefhis = .true.
  nwrt = 270
  nrpfhis = 0
  hisname = "jet_his.nc"
/

&croco_restart
  nrst = 4860
  nrpfrst = -1
  rstname = "jet_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 1.5e-3
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_lin_eos
  R0 = 0.d0
  T0 = 0.d0
  S0 = 0.d0
  Tcoef = -1.0d0
  Scoef = 0.d0
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/

&croco_diagM_history_fields
  out_his_diagM_u = .true.
  out_his_diagM_v = .true.
/


! End of namelist
