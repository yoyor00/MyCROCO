&croco_title
  title = "JET Example (use make_jet.m for non ANA_JET config)"
/

&croco_time_stepping
  ntimes = 4860
  dt = 3200
  ndtfast = 80
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 100
/

&croco_s_coord
  theta_s = 5.0d0
  theta_b = 0.0d0
  Tcline = 100.0d0
/

&croco_history
  ldefhis = .true.
  nwrt = 270
  nrpfhis = 0
  hisname = "jet_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/xxxxx"
/

&croco_restart
  nrst = 4860
  nrpfrst = -1
  rstname = "jet_rst.nc"
/

&croco_grid
  grdname = "TEST_CASES/xxxxx"
/

&croco_climatology
  clmname = "TEST_CASES/xxxxx"
/

&croco_lin_eos
  R0 = 0.d0
  T0 = 0.d0
  S0 = 0.d0
  Tcoef = -1.0d0
  Scoef = 0.d0
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 1.5e-3
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/


! End of namelist
