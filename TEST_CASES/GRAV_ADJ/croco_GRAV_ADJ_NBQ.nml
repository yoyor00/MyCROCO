&croco_testcase
  testcase_name = 'GRAV_ADJ'
/

&croco_title
  title = "Gravitational Adjustment Example"
/

&croco_time_stepping
  ntimes = 1000
  dt = 0.01
  ndtfast = 35
  ninfo = 100
/

&croco_time_stepping_nbq
  csound_nbq = 10
  visc2_nbq = 1.e-2
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  hc = 1.d16
/

&croco_initial
  nrrec = 0
  ininame = "gravadj_rst.nc"
/

&croco_history
  ldefhis = .true.
  nwrt = 40
  nrpfhis = 0
  hisname = "gravadj_his.nc"
/

&croco_restart
  nrst = 1000
  nrpfrst = -1
  rstname = "gravadj_rst.nc"
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.e-6
  visc4 = 0.e-6
/

&croco_tracer_diff2
  tnu2 = 1*0.
/

&croco_vertical_mixing
  Akv_bak = 0.e-6
  Akt_bak = 1*0.e-6
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/



! End of namelist
