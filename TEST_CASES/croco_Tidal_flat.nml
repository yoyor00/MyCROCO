&croco_title
  title = "Tide Flat 2DV TEST MODEL"
/

&croco_time_stepping
  ntimes = 8640
  dt = 15
  ndtfast = 5
  ninfo = 100
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 500.0d0
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-03 00:00:00"
  dt_his = 0.25
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 100
  nrpfhis = 0
  hisname = "tidal_flat_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 720000
  nrpfrst = -1
  rstname = "tidal_flat_rst.nc"
/

&croco_sponge
  x_sponge = 1000.
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 5*.true.
/

&croco_lin_eos
  R0 = 30.d0
  T0 = 20.d0
  S0 = 35.5d0
  Tcoef = 0.0d-10
  Scoef = 0.0d-10
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_Tidal_flat.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_Tidal_flat.txt"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-03
  rdrg2 = 0.0d-3
  Zobt = 1.0d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 1.27
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 5*0.d0
/

&croco_gls_history_fields
  his_tke = .false.
  his_gls = .false.
  his_lscale = .false.
/


! End of namelist
