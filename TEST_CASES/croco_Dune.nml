&croco_title
  title = "Dune Test case"
/

&croco_time_stepping
  ntimes = 172800
  dt = 1
  ndtfast = 20
  ninfo = 1
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-03 00:00:00"
  dt_his = 24
  dt_avg = 24
  dt_rst = 24
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0d0
  Tcline = 10000
/

&croco_initial
  nrrec = 0
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 30.
  tauM_in = 0.1
  tauM_out = 100.
/

&croco_history
  ldefhis = .true.
  nwrt = 86400
  nrpfhis = 0
  hisname = "dune_his.nc"
/

&croco_restart
  nrst = 172800
  nrpfrst = 0
  rstname = "dune_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 1.e-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.0
/

&croco_tracer_diff4
  tnu4 = 2*0.0
/

&croco_lin_eos
  R0 = 26.65
  T0 = 10.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_dune.in"
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV2_Dune.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_Dune.txt"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_bvf_history_fields
  out_his_bvf = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_morphodyn_history_fields
  out_his_hm = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .true.
  out_his_sed_bthk = .true.
  out_his_sed_bpor = .true.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 2*.true.
/

&croco_sediment_bedload_history_fields
  out_his_sed_bdlu = 2*.true.
  out_his_sed_bdlv = 2*.true.
/



! End of namelist
