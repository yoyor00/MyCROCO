&croco_title
  title = "Canyon Example"
/

&croco_time_stepping
  ntimes = 240
  dt = 360
  ndtfast = 65
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 20.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 120
  nrpfhis = 0
  hisname = "canyon_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "canyon_ini.nc"
/

&croco_restart
  nrst = 240
  nrpfrst = -1
  rstname = "canyon_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28d0
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 1*1.e-6
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/


! End of namelist
