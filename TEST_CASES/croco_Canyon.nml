&croco_title
  title = "Canyon Example"
/

&croco_time_stepping
  ntimes = 240
  dt = 360
  ndtfast = 65
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 20.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 120
  nrpfhis = 0
  hisname = "canyon_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "canyon_ini.nc"
/

&croco_restart
  nrst = 240
  nrpfrst = -1
  rstname = "canyon_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 1*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28d0
  Scoef = 0.
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 1*1.e-6
/


! End of namelist
