  rstname = "swash_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 1.e-5
  tauT_out = 0.01
  tauM_in = 1.e-5
  tauM_out = 0.01
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .false.
/

