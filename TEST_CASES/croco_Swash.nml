&croco_title
  title = "Swash Example"
/

&croco_time_stepping
  ntimes = 106700
  dt = 0.0019532775
  ndtfast = 5
  ninfo = 200
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 50
  visc2_nbq = 0.
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_initial
  nrrec = 0
  ininame = "swash_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_wetdry
  D_wetdry = 0.001
/

&croco_nudging
  tauT_in = 1.e-5
  tauT_out = 0.01
  tauM_in = 1.e-5
  tauM_out = 0.01
/

&croco_history
  ldefhis = .true.
  nwrt = 10670
  nrpfhis = 0
  hisname = "swash_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 12190
  nrpfavg = 0
  avgname = "swash_avg.nc"
/

&croco_restart
  nrst = 900000
  nrpfrst = -1
  rstname = "swash_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 1.e-6
  Akt_bak = 1*1.e-6
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_wave_maker
  wmaker_amp = 0.0442
  wmaker_prd = 2.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .false.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.false.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .true.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .false.
  out_his_lscale = .true.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .false.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 1*.false.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .false.
  out_avg_omega = .false.
  out_avg_w = .true.
  out_avg_akv = .true.
  out_avg_bostr = .true.
  out_avg_bustr = .true.
  out_avg_bvstr = .true.
  out_avg_wstr = .false.
  out_avg_ustr = .false.
  out_avg_vstr = .false.
/

&croco_temperature_averages_fields
  out_avg_akt = .false.
  out_avg_shflx = .false.
  out_avg_shflx_rsw = .false.
/

&croco_salinity_averages_fields
  out_avg_aks = .false.
  out_avg_swflx = .false.
/

