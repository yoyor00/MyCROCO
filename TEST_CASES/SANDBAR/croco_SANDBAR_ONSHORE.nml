&croco_testcase
  testcase_name = 'SANDBAR_ONSHORE'
/

&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  hc = 1.e16
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_wetdry
  D_wetdry = 0.1
/

&croco_nudging
  tauT_in = 0.1
  tauT_out = 0.1
  tauM_in = 0.1
  tauM_out = 0.1
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-5
  Cdb_min = 1.e-5
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_wkb_wwave
  wkb_amp = 0.18
  wkb_ang = 0.0
  wkb_prd = 8.
  wkb_tide = 0.0
  wkb_btg = 0.6
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.15
  wkb_roller = 1.8
/

&croco_sediments
  sedname = "TEST_CASES/SANDBAR/sediment_sandbar_1C.in"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 3*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .true.
  out_his_sed_bthk = .true.
  out_his_sed_bpor = .true.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 2*.true.
/

&croco_sediment_suspload_history_fields
  out_his_sed_dflx = 2*.true.
  out_his_sed_eflx = 2*.true.
/

&croco_sediment_bedload_history_fields
  out_his_sed_bdlu = 2*.true.
  out_his_sed_bdlv = 2*.true.
/

&croco_bbl_history_fields
  out_his_abed = .true.
  out_his_hripple = .true.
  out_his_lripple = .true.
  out_his_zbnot = .true.
  out_his_zbapp = .true.
  out_his_bostrw = .true.
/

&croco_wci_history_fields
  out_his_sup = .true.
  out_his_ust2d = .true.
  out_his_vst2d = .true.
/

&croco_wci_history_3d_fields
  out_his_ust = .true.
  out_his_vst = .true.
  out_his_wst = .true.
  out_his_akb = .true.
  out_his_akw = .true.
  out_his_kvf = .true.
  out_his_calp = .true.
  out_his_kaps = .true.
/

&croco_wave_history_fields
  out_his_hrm = .true.
  out_his_frq = .true.
  out_his_action = .false.
  out_his_k_xi = .true.
  out_his_k_eta = .true.
  out_his_eps_b = .true.
  out_his_eps_d = .true.
  out_his_erol = .true.
  out_his_eps_r = .true.
/



! End of namelist
