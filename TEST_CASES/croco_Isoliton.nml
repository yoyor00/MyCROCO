&croco_title
  title = "Gravitational Adjustment Example"
/

&croco_time_stepping
  ntimes = 1400
  dt = 0.20
  ndtfast = 25
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10
  visc2_nbq = 1.e-2
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.d16
/

&croco_history
  ldefhis = .true.
  nwrt = 20
  nrpfhis = 0
  hisname = "isoliton_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "isoliton_rst.nc"
/

&croco_restart
  nrst = 7000
  nrpfrst = -1
  rstname = "isoliton_rst.nc"
/


! End of namelist
