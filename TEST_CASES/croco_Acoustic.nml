&croco_title
  title = "Acoustic waves example"
/

&croco_time_stepping
  ntimes = 200
  dt = 0.0005
  ndtfast = 1
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1500
  visc2_nbq = 0.
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.d16
/

&croco_history
  ldefhis = .true.
  nwrt = 1
  nrpfhis = 0
  hisname = "acous_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "INPUT/gravadj_rst.nc"
/

&croco_restart
  nrst = 2000
  nrpfrst = -1
  rstname = "acous_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.
/

&croco_vertical_mixing
  Akv_bak = 0.e-6
  Akt_bak = 1*0.e-6
/


! End of namelist
