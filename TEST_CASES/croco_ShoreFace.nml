&croco_title
  title = "SHOREFACE Example"
/

&croco_time_stepping
  ntimes = 7200
  dt = 5.
  ndtfast = 30
  ninfo = 72
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 720
  nrpfhis = 0
  hisname = "shoreface_his.nc"
/

&croco_initial
  nrrec = 0
/

&croco_restart
  nrst = 7200
  nrpfrst = -1
  rstname = "shoreface_rst.nc"
/

&croco_forcing
  frcname = "TEST_CASES/shoreface_JW_frc.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.0
  rdrg2 = 1.5e-3
  Zobt = 0.0
  Cdb_min = 0.0
  Cdb_max = 0.0
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 1*0.
/

&croco_wkb_wwave
  wkb_amp = 0.707
  wkb_ang = -10.0
  wkb_prd = 10.
  wkb_tide = 0.0
  wkb_btg = 0.8
  wkb_gam = 0.4
/

&croco_wkb_roller
  wkb_rsb = 0.1
  wkb_roller = 0.0
/

&croco_averages
  ntsavg = 1
  navg = 720
  nrpfavg = 0
  avgname = "shoreface_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 1440
  nrpfdia = 0
  dianame = "shoreface_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 1440
  nrpfdia_avg = 0
  dianame_avg = "shoreface_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/


