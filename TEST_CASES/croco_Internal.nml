&croco_title
  title = "Internal Tide 2D-V Example"
/

&croco_time_stepping
  ntimes = 992
  dt = 540
  ndtfast = 60
  ninfo = 10
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  hc = 2000.d0
/

&croco_initial
  nrrec = 0
  ininame = "internal_rst.nc"
/

&croco_history
  ldefhis = .true.
  nwrt = 32
  nrpfhis = 0
  hisname = "internal_his.nc"
/

&croco_restart
  nrst = 992
  nrpfrst = -1
  rstname = "internal_rst.nc"
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.
/

&croco_vertical_mixing
  Akv_bak = 1.e-5
  Akt_bak = 1*1.e-5
/

&croco_lin_eos
  R0 = 0.
  T0 = 0.
  S0 = 0.
  Tcoef = -1.
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/



! End of namelist
