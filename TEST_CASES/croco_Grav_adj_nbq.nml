&croco_title
  title = "Gravitational Adjustment Example"
/

&croco_time_stepping
  ntimes = 1000
  dt = 0.01
  ndtfast = 35
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10
  visc2_nbq = 1.e-2
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.d16
/

&croco_history
  ldefhis = .true.
  nwrt = 40
  nrpfhis = 0
  hisname = "gravadj_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "gravadj_rst.nc"
/

&croco_restart
  nrst = 1000
  nrpfrst = -1
  rstname = "gravadj_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.e-6
  visc4 = 0.e-6
/

&croco_tracer_diff2
  tnu2 = 1*0.
/

&croco_vertical_mixing
  Akv_bak = 0.e-6
  Akt_bak = 1*0.e-6
/


! End of namelist
