&croco_title
  title = "Gravitational Adjustment Example"
/

&croco_time_stepping
  ntimes = 1000
  dt = 0.01
  ndtfast = 35
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 10
  visc2_nbq = 1.e-2
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.d16
/

&croco_history
  ldefhis = .true.
  nwrt = 40
  nrpfhis = 0
  hisname = "gravadj_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "gravadj_rst.nc"
/

&croco_restart
  nrst = 1000
  nrpfrst = -1
  rstname = "gravadj_rst.nc"
/


! End of namelist
