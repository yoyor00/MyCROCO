&croco_title
  title = "Shelf Front Example"
/

&croco_time_stepping
  ntimes = 720
  dt = 1200
  ndtfast = 50
  ninfo = 1
/

&croco_s_coord
  theta_s = 1.0d0
  theta_b = 0.0d0
  Tcline = 10.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 72
  nrpfhis = 0
  hisname = "shelfront_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "shelfront_rst.nc"
/

&croco_restart
  nrst = 720
  nrpfrst = -1
  rstname = "shelfront_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_lin_eos
  R0 = 30.
  T0 = 15.
  S0 = 35.
  Tcoef = 0.28d0
  Scoef = 0.78d0
/

&croco_rho0
  rho0 = 1025.
/

&croco_bottom_drag
  rdrg = 3.e-4
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_vertical_mixing
  Akv_bak = 1.e-4
  Akt_bak = 2*1.e-6
/


! End of namelist
