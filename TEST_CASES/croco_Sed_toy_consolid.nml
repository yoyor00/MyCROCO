&croco_title
  title = "SED TOY Mixed bed Consolidation TEST MODEL"
/

&croco_time_stepping
  ntimes = 1728000
  dt = 2.
  ndtfast = 20
  ninfo = 40
/

&croco_s_coord
  theta_s = 1.0
  theta_b = 0.8
  Tcline = 0.
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-02-10 00:00:00"
  dt_his = 1
  dt_avg = 1
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 3600
  nrpfhis = 0
  hisname = "sed_toy_consolid_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 1728000
  nrpfrst = -1
  rstname = "sed_toy_consolid_rst.nc"
/

&croco_lin_eos
  R0 = 27
  T0 = 10.
  S0 = 35.
  Tcoef = 1.7d-4
  Scoef = 7.6d-4
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sed_toy_consolid.in"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 3.0d-04
  rdrg2 = 3.0d-03
  Zobt = 0.0005
  Cdb_min = 1.d-6
  Cdb_max = 5.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 6*0.d0
/

&croco_tracer_diff4
  tnu4 = 6*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.d-05
  Akt_bak = 6*1.d-06
/

&croco_averages
  ntsavg = 1
  navg = 3600
  nrpfavg = 0
  avgname = "sed_toy_consolid_avg.nc"
/

&croco_gls_history_fields
  his_tke = .true.
  his_gls = .true.
  his_lscale = .true.
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 6*.true.
/

&croco_auxiliary_history_fields
  his_rho = .true.
  his_omega = .true.
  his_w = .true.
  his_akv = .true.
  his_bostr = .true.
  his_wstr = .true.
  his_ustr = .true.
  his_vstr = .true.
/

&croco_temperature_history_fields
  his_akt = .true.
  his_shflx = .true.
  his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  his_aks = .true.
  his_swflx = .true.
/

&croco_bulk_flux_history_fields
  his_shflx_rlw = .true.
  his_shflx_lat = .true.
  his_shflx_sen = .true.
/

&croco_hbl_history_fields
  his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  his_hbbl = .true.
/

&croco_vis_coef_history_fields
  his_visc3d = .true.
/

&croco_dif_coef_history_fields
