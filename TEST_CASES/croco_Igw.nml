&croco_title
  title = "IGW TEST MODEL"
/

&croco_time_stepping
  ntimes = 5760
  dt = 150
  ndtfast = 60
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.0d16
/

&croco_initial
  nrrec = 0
  ininame = "TEST_CASES/XXXX"
/

&croco_grid
  grdname = "TEST_CASES/igw_grd.nc"
/

&croco_forcing
  frcname = "TEST_CASES/igw_frc.nc"
/

&croco_climatology
  clmname = "TEST_CASES/XXXX"
/

&croco_sponge
  x_sponge = 20.e+3
/

&croco_nudging
  tauT_in = 0.05
  tauT_out = 0.05
  tauM_in = 0.05
  tauM_out = 0.05
/

&croco_history
  ldefhis = .true.
  nwrt = 72
  nrpfhis = 0
  hisname = "igw_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 5760
  nrpfavg = 0
  avgname = "igw_avg.nc"
/

&croco_restart
  nrst = 5760
  nrpfrst = -1
  rstname = "igw_rst.nc"
/

&croco_rho0
  rho0 = 1027.d0
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 1*0.d0
/

&croco_tracer_diff4
  tnu4 = 1*0.d11
/

&croco_vertical_mixing
  Akv_bak = 1.d-05
  Akt_bak = 1*1.d-06
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 1*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .true.
  out_his_bustr = .true.
  out_his_bvstr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .true.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .true.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .true.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .true.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 1*.true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .false.
  out_avg_omega = .true.
  out_avg_w = .true.
  out_avg_akv = .false.
  out_avg_bostr = .true.
  out_avg_bustr = .true.
  out_avg_bvstr = .true.
  out_avg_wstr = .true.
  out_avg_ustr = .true.
  out_avg_vstr = .false.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .false.
  out_avg_shflx_rsw = .false.
/

&croco_salinity_averages_fields
  out_avg_aks = .true.
  out_avg_swflx = .false.
/

&croco_bulk_flux_averages_fields
  out_avg_shflx_rlw = .false.
  out_avg_shflx_lat = .false.
  out_avg_shflx_sen = .false.
/

&croco_hbl_averages_fields
  out_avg_hbl = .true.
/

&croco_lmd_bkpp_averages_fields
  out_avg_hbbl = .true.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .true.
/

&croco_dif_coef_averages_fields
  out_avg_diff3d = .true.
/

&croco_biology_averages_fields
  out_avg_hel = .false.
/


