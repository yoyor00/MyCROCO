&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.025
  ndtfast = 12
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.
  theta_b = 8.
  Tcline = 2.
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 36000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_wave_maker
  wmaker_amp = 0.49
  wmaker_prd = 5.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/


! End of namelist
