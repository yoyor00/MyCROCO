&croco_testcase
  testcase_name = 'ANA_DUNE'
/

&croco_title
  title = "Dune Test case (Analytical case)"
/

&croco_time_stepping
  ntimes = 72000
  dt = 0.1
  ndtfast = 60
  ninfo = 100
/

&croco_use_calendar
  start_date = "2019-01-01 00:00:00"
  end_date = "2019-01-01 02:00:00"
  dt_his = 0.5
  dt_avg = 4
  dt_rst = 4
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0d0
  hc = 10000
/

&croco_initial
  nrrec = 0
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 30.
  tauM_in = 0.1
  tauM_out = 100.
/

&croco_history
  ldefhis = .true.
  nwrt = 18000
  nrpfhis = 0
  hisname = "ana_dune_his.nc"
/

&croco_restart
  nrst = 72000
  nrpfrst = 0
  rstname = "ana_dune_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.0e-04
  rdrg2 = 0.0e-3
  Zobt = 0.0001
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.0
/

&croco_tracer_diff4
  tnu4 = 2*0.0
/

&croco_lin_eos
  R0 = 26.65
  T0 = 10.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/DUNE/sediment_ana_dune.in"
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV2_Ana_dune.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_Ana_dune.txt"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_bvf_history_fields
  out_his_bvf = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_morphodyn_history_fields
  out_his_hm = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .true.
  out_his_sed_bthk = .true.
  out_his_sed_bpor = .true.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 1*.true.
/

&croco_sediment_bedload_history_fields
  out_his_sed_bdlu = 1*.true.
  out_his_sed_bdlv = 1*.true.
/



! End of namelist
