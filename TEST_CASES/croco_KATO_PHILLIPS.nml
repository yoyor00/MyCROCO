&croco_title
  title = "SCM TEST MODEL"
/

&croco_time_stepping
  ntimes = 3600
  dt = 30
  ndtfast = 60
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.0d16
/

&croco_history
  ldefhis = .true.
  nwrt = 120
  nrpfhis = 0
  hisname = "scm_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "fileini"
/

&croco_restart
  nrst = 3600
  nrpfrst = -1
  rstname = "scm_rst.nc"
/

&croco_grid
  grdname = "filegrid"
/

&croco_forcing
  frcname = "fileforc"
/

&croco_bulk_forcing
  bulkname = "filebulk"
/

&croco_climatology
  clmname = "fileclim"
/

&croco_biology
  bioname = "CROCO_FILES/croco_frcbio.nc"
/

&croco_boundary
  bry_file = "filebound"
/

&croco_lin_eos
  R0 = 24
  T0 = 16.
  S0 = 0.
  Tcoef = 0.2
  Scoef = 0.
/

&croco_sediments
  sedname = "sediment_flume.in"
/

&croco_averages
  ntsavg = 1
  navg = 120
  nrpfavg = 0
  avgname = "scm_avg.nc"
/


! End of namelist
