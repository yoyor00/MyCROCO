&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.025
  ndtfast = 12
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.
  theta_b = 8.
  Tcline = 2.
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 36000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 1.e-5
  tauT_out = 1.e-3
  tauM_in = 1.e-5
  tauM_out = 1.e-3
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C_nbq.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-4
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 3*0.
/

&croco_wave_maker
  wmaker_amp = 0.21
  wmaker_prd = 8.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_stations
  ldefsta = .true.
  nsta = 8
  nrpfsta = 0
  staposname = "stations.in"
  staname = "stations.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 300
  nrpfdia = 0
  dianame = "sandbar_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 250
  nrpfdia_avg = 0
  dianame_avg = "sandbar_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/
&croco_diags_eddy_avg
  ldefdiags_eddy_avg = .true.
  ntsdiags_eddy_avg = 1
  nwrtdiags_eddy_avg = 6000
  nrpfdiags_eddy_avg = 0
  diags_eddyname_avg = "sandbar_diags_eddy_avg.nc"
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_gls_averages_fields
  out_avg_tke = .true.
  out_avg_gls = .true.
  out_avg_lscale = .true.
/

&croco_station_fields
  sta_grd = .true.
  sta_temp = .true.
  sta_salt = .false.
  sta_rho = .false.
  sta_vel = .true.
/

&croco_bbl_history_fields
  out_his_abed = .false.
  out_his_hripple = .false.
  out_his_lripple = .false.
  out_his_zbnot = .false.
  out_his_zbapp = .false.
  out_his_bostrw = .false.
/

&croco_wci_history_fields
  out_his_sup = .true.
  out_his_ust2d = .true.
  out_his_vst2d = .true.
/

&croco_wci_history_3d_fields
  out_his_ust = .true.
  out_his_vst = .true.
  out_his_wst = .true.
  out_his_akb = .true.
  out_his_akw = .true.
  out_his_kvf = .true.
  out_his_calp = .true.
  out_his_kaps = .true.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 3*.true.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 3*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_salinity_history_fields
  out_his_aks = .false.
  out_his_swflx = .true.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .true.
  out_his_shflx_lat = .true.
  out_his_shflx_sen = .true.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .true.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .false.
  out_avg_omega = .false.
  out_avg_w = .true.
  out_avg_akv = .true.
  out_avg_bostr = .true.
  out_avg_wstr = .true.
  out_avg_ustr = .true.
  out_avg_vstr = .true.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .true.
  out_avg_shflx_rsw = .true.
/

&croco_salinity_averages_fields
  out_avg_aks = .false.
  out_avg_swflx = .true.
/

&croco_bulk_flux_averages_fields
  out_avg_shflx_rlw = .true.
  out_avg_shflx_lat = .true.
  out_avg_shflx_sen = .true.
/

&croco_hbl_averages_fields
  out_avg_hbl = .true.
/

&croco_lmd_bkpp_averages_fields
  out_avg_hbbl = .true.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  out_avg_diff3d = .false.
/

&croco_biology_averages_fields
  out_avg_hel = .true.
/

&croco_diag3D_history_fields
  out_his_dia3D_tracer = 3*.true.
/

&croco_diag2D_history_fields
  out_his_dia2D_tracer = 3*.true.
/

&croco_diag3D_average_fields
  out_avg_dia3D_tracer = 3*.true.
/

&croco_diag2D_average_fields
  out_avg_dia2D_tracer = 3*.true.
/

&croco_diags_eddy_history_fields
  out_his_diags_eddy = .false.
/

&croco_diags_eddy_average_fields
  out_avg_diags_eddy = .true.
/


! End of namelist
