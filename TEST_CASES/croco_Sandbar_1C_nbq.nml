&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.025
  ndtfast = 12
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.
  theta_b = 8.
  Tcline = 2.
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_wetdry
  D_wetdry = 0.1
/

&croco_nudging
  tauT_in = 1.e-5
  tauT_out = 1.e-3
  tauM_in = 1.e-5
  tauM_out = 1.e-3
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_restart
  nrst = 36000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-4
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_diags_eddy_avg
  ldefdiags_eddy_avg = .true.
  ntsdiags_eddy_avg = 1
  nwrtdiags_eddy_avg = 6000
  nrpfdiags_eddy_avg = 0
  diags_eddyname_avg = "sandbar_diags_eddy_avg.nc"
/

&croco_wave_maker
  wmaker_amp = 0.21
  wmaker_prd = 8.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C_nbq.in"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 3*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .true.
  out_his_bostr = .true.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .true.
  out_his_shflx_rsw = .true.
/

&croco_hbl_history_fields
  out_his_hbl = .true.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_gls_history_fields
  out_his_tke = .true.
  out_his_gls = .true.
  out_his_lscale = .true.
/

&croco_sediment_history_fields
  out_his_sed_athk = .false.
  out_his_sed_bthk = .false.
  out_his_sed_bpor = .false.
/

&croco_sediment_bfra_history_fields
  out_his_sed_bfra = 2*.false.
/

&croco_sediment_suspload_history_fields
  out_his_sed_dflx = 2*.false.
  out_his_sed_eflx = 2*.false.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 3*.true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .false.
  out_avg_omega = .false.
  out_avg_w = .true.
  out_avg_akv = .true.
  out_avg_bostr = .true.
  out_avg_wstr = .true.
  out_avg_ustr = .true.
  out_avg_vstr = .true.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .true.
  out_avg_shflx_rsw = .true.
/

&croco_hbl_averages_fields
  out_avg_hbl = .true.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .false.
/

&croco_gls_averages_fields
  out_avg_tke = .true.
  out_avg_gls = .true.
  out_avg_lscale = .true.
/

&croco_diags_eddy_average_fields
  out_avg_diags_eddy = .true.
/



! End of namelist
