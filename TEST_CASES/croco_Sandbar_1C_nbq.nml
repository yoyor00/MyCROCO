&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.025
  ndtfast = 12
  ninfo = 100
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 100
  visc2_nbq = 0.0
/

&croco_s_coord
  theta_s = 0.
  theta_b = 8.
  Tcline = 2.
/

&croco_history
  ldefhis = .true.
  nwrt = 6000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 36000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/

&croco_lin_eos
  R0 = 30.
  T0 = 0.
  S0 = 0.
  Tcoef = 0.28
  Scoef = 0.
/

&croco_sediments
  sedname = "TEST_CASES/sediment_sandbar_1C_nbq.in"
/

&croco_rho0
  rho0 = 1024.4
/

&croco_bottom_drag
  rdrg = 0.
  rdrg2 = 0.
  Zobt = 5.e-4
  Cdb_min = 1.e-7
  Cdb_max = 1.e-1
/

&croco_gamma2
  gamma2 = 1.
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 3*0.d0
/

&croco_vertical_mixing
  Akv_bak = 0.
  Akt_bak = 3*0.
/

&croco_wave_maker
  wmaker_amp = 0.21
  wmaker_prd = 8.0
  wmaker_dir = 0.
  wmaker_dsp = 0.
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 6000
  nrpfavg = 0
  avgname = "sandbar_avg.nc"
/

&croco_stations
  ldefsta = .true.
  nsta = 8
  nrpfsta = 0
  staposname = "stations.in"
  staname = "stations.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 300
  nrpfdia = 0
  dianame = "sandbar_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 250
  nrpfdia_avg = 0
  dianame_avg = "sandbar_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_diags_eddy
  ldefdiags_eddy = .false.
  nwrtdiags_eddy = 6000
  nrpfdiags_eddy = 0
  diags_eddyname = "sandbar_diags_eddy.nc"
/

&croco_diags_eddy_avg
  ldefdiags_eddy_avg = .true.
  ntsdiags_eddy_avg = 1
  nwrtdiags_eddy_avg = 6000
  nrpfdiags_eddy_avg = 0
  diags_eddyname_avg = "sandbar_diags_eddy_avg.nc"
/


! End of namelist
