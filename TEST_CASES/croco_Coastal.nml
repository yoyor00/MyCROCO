&croco_title
  title = "LOIRE TEST MODEL"
/

&croco_time_stepping
  ntimes = 10000
  dt = 40
  ndtfast = 10
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_use_calendar
  start_date = "2015-01-01 00:00:00"
  end_date = "2015-01-01 12:00:00"
  dt_his = 1.0
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 150
  nrpfhis = 0
  hisname = "croco_his.nc"
/

&croco_initial
  nrrec = 1
  ininame = "vilaine_ini.nc"
/

&croco_restart
  nrst = 14400
  nrpfrst = -1
  rstname = "croco_rst.nc"
/

&croco_grid
  grdname = "croco_grd.nc"
/

&croco_forcing
  frcname = "croco_frc_vilaine.nc"
/

&croco_bulk_forcing
  bulkname = "bidon.nc"
/

&croco_climatology
  clmname = "croco_clm.nc"
/

&croco_wave_offline
  wave_file = "wave_vilaine_201501.nc"
/

&croco_boundary
  bry_file = "bry_vilaine_201501.nc"
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_vilaine.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_vilaine.txt"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-4
  rdrg2 = 1.d-3
  Zobt = 3.5d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-2
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.0
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 5*0.d-2
/

&croco_tracer_diff4
  tnu4 = 5*0.d11
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 5*0.d0
/

&croco_averages
  ntsavg = 1
  navg = 1000000
  nrpfavg = 0
  avgname = "croco_avg.nc"
/


! End of namelist
