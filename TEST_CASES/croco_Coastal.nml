&croco_title
  title = "LOIRE TEST MODEL"
/

&croco_time_stepping
  ntimes = 10000
  dt = 40
  ndtfast = 10
  ninfo = 1
/

&croco_use_calendar
  start_date = "2015-01-01 00:00:00"
  end_date = "2015-01-01 12:00:00"
  dt_his = 1.0
  dt_avg = 24
  dt_rst = 24
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  hc = 1.e16
/

&croco_initial
  nrrec = 1
  ininame = "vilaine_ini.nc"
/

&croco_grid
  grdname = "croco_grd.nc"
/

&croco_forcing
  frcname = "croco_frc_vilaine.nc"
/

&croco_boundary
  bry_file = "bry_vilaine_201501.nc"
/

&croco_wetdry
  D_wetdry = 0.2
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_history
  ldefhis = .true.
  nwrt = 150
  nrpfhis = 0
  hisname = "croco_his.nc"
/

&croco_restart
  nrst = 14400
  nrpfrst = -1
  rstname = "croco_rst.nc"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-4
  rdrg2 = 1.d-3
  Zobt = 3.5d-4
  Cdb_min = 1.d-4
  Cdb_max = 1.d-2
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.0
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 5*0.d-2
/

&croco_tracer_diff4
  tnu4 = 5*0.d11
/

&croco_online
  yearnum = 2014
  monthnum = 12
  recordsperday = 24
  yearend = 2016
  monthend = 1
  pathbulk = "met_vilaine_201501.nc"
/

&croco_wave_offline
  wave_file = "wave_vilaine_201501.nc"
/

&croco_psource
  psource_Nsrc = 2
/

&croco_psource_ncfile_data
  psource_qbarname = "croco_runoff_vilaine.nc"
  psource_Isrc(   1) =   167, psource_Jsrc(   1) =    56, psource_Dsrc(   1) =     0, psource_qbardir(   1) =    -1
  psource_Isrc(   2) =    91, psource_Jsrc(   2) =    99, psource_Dsrc(   2) =     0, psource_qbardir(   2) =    -1
/

&croco_psource_tracer
  psource_Lsrc(1,1) = T
  psource_Lsrc(1,2) = T
  psource_Lsrc(1,3) = T
  psource_Lsrc(1,4) = T
  psource_Lsrc(1,5) = T
  psource_Lsrc(2,1) = T
  psource_Lsrc(2,2) = T
  psource_Lsrc(2,3) = T
  psource_Lsrc(2,4) = T
  psource_Lsrc(2,5) = T
  psource_Tsrc0(1,1) = 20.0
  psource_Tsrc0(1,2) = 15.0
  psource_Tsrc0(1,3) = 0.
  psource_Tsrc0(1,4) = 0.
  psource_Tsrc0(1,5) = 0.
  psource_Tsrc0(2,1) = 20.0
  psource_Tsrc0(2,2) = 15.0
  psource_Tsrc0(2,3) = 0.
  psource_Tsrc0(2,4) = 0.
  psource_Tsrc0(2,5) = 0.
/

&croco_sediments_mustang
  sedname_must = "MUSTANG_NAMELIST/paraMUSTANGV1_vilaine.txt"
/

&croco_substance
  subsfilename = "MUSTANG_NAMELIST/parasubstance_MUSTANG_vilaine.txt"
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 5*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .false.
  out_his_akv = .false.
  out_his_bostr = .true.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .false.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
  out_his_swflx = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_gls_history_fields
  out_his_tke = .false.
  out_his_gls = .false.
  out_his_lscale = .false.
/


