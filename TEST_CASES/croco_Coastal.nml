&croco_title
  title = "LOIRE TEST MODEL"
/

&croco_time_stepping
  ntimes = 10000
  dt = 40
  ndtfast = 10
  ninfo = 1
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_use_calendar
  start_date = "2015-01-01 00:00:00"
  end_date = "2015-01-01 12:00:00"
  dt_his = 1.0
  dt_avg = 24
  dt_rst = 24
/

&croco_history
  ldefhis = .true.
  nwrt = 150
  nrpfhis = 0
  hisname = "croco_his.nc"
/

&croco_initial
  nrrec = 1
  ininame = "vilaine_ini.nc"
/

&croco_restart
  nrst = 14400
  nrpfrst = -1
  rstname = "croco_rst.nc"
/

&croco_grid
  grdname = "croco_grd.nc"
/

&croco_forcing
  frcname = "croco_frc_vilaine.nc"
/

&croco_sponge
  x_sponge = XXX
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_bulk_forcing
  bulkname = "bidon.nc"
/

&croco_climatology
  clmname = "croco_clm.nc"
/

&croco_wave_offline
  wave_file = "wave_vilaine_201501.nc"
/

&croco_boundary
