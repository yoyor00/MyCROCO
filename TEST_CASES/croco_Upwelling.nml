&croco_title
  title = "Upwelling Example"
/

&croco_time_stepping
  ntimes = 410
  dt = 960
  ndtfast = 48
  ninfo = 1
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 0.0d0
  Tcline = 50.d0
/

&croco_history
  ldefhis = .true.
  nwrt = 82
  nrpfhis = 0
  hisname = "upwelling_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "upwelling_rst.nc"
/

&croco_restart
  nrst = 410
  nrpfrst = -1
  rstname = "upwelling_rst.nc"
/

&croco_primary_history_fields
  his_zeta = .true.
  his_ubar = .true.
  his_vbar = .true.
/

&croco_primary_history_3d_fields
  his_u = .true.
  his_v = .true.
/

&croco_primary_history_tracer_fields
  his_tracer = 2*.true.
/

&croco_primary_average_fields
  avg_zeta = .true.
  avg_ubar = .true.
  avg_vbar = .true.
/

&croco_primary_3d_average_fields
  avg_u = .true.
  avg_v = .true.
/

&croco_primary_tracer_average_fields
  avg_tracer = 2*.true.
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 3.0E-04
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_averages
  ntsavg = 1
  navg = 82
  nrpfavg = 0
  avgname = "upwelling_avg.nc"
/


! End of namelist
