&croco_title
  title = "Upwelling Example"
/

&croco_time_stepping
  ntimes = 410
  dt = 960
  ndtfast = 48
  ninfo = 1
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 0.0d0
  Tcline = 50.d0
/

&croco_initial
  nrrec = 0
  ininame = "upwelling_rst.nc"
/

&croco_history
  ldefhis = .true.
  nwrt = 82
  nrpfhis = 0
  hisname = "upwelling_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 82
  nrpfavg = 0
  avgname = "upwelling_avg.nc"
/

&croco_restart
  nrst = 410
  nrpfrst = -1
  rstname = "upwelling_rst.nc"
/

&croco_rho0
  rho0 = 1000.
/

&croco_bottom_drag
  rdrg = 3.0E-04
  rdrg2 = 0.
  Zobt = 0.
  Cdb_min = 0.
  Cdb_max = 0.
/

&croco_gamma2
  gamma2 = 1.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .true.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .false.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .false.
  out_his_ustr = .false.
  out_his_vstr = .false.
/

&croco_temperature_history_fields
  out_his_akt = .true.
  out_his_shflx = .false.
  out_his_shflx_rsw = .false.
/

&croco_salinity_history_fields
  out_his_aks = .false.
/

&croco_bulk_flux_history_fields
  out_his_shflx_rlw = .false.
  out_his_shflx_lat = .false.
  out_his_shflx_sen = .false.
/

&croco_hbl_history_fields
  out_his_hbl = .false.
/

&croco_lmd_bkpp_history_fields
  out_his_hbbl = .false.
/

&croco_vis_coef_history_fields
  out_his_visc3d = .false.
/

&croco_dif_coef_history_fields
  out_his_diff3d = .false.
/

&croco_biology_history_fields
  out_his_hel = .false.
/

&croco_morphodyn_history_fields
  out_his_hm = .false.
/

&croco_primary_average_fields
  out_avg_zeta = .true.
  out_avg_ubar = .true.
  out_avg_vbar = .true.
/

&croco_primary_3d_average_fields
  out_avg_u = .true.
  out_avg_v = .true.
/

&croco_primary_tracer_average_fields
  out_avg_tracer = 2*.true.
/

&croco_auxiliary_averages_fields
  out_avg_rho = .true.
  out_avg_omega = .false.
  out_avg_w = .true.
  out_avg_akv = .false.
  out_avg_bostr = .false.
  out_avg_bustr = .false.
  out_avg_bvstr = .false.
  out_avg_wstr = .false.
  out_avg_ustr = .false.
  out_avg_vstr = .false.
/

&croco_temperature_averages_fields
  out_avg_akt = .true.
  out_avg_shflx = .false.
  out_avg_shflx_rsw = .false.
/

&croco_salinity_averages_fields
  out_avg_aks = .false.
/

&croco_bulk_flux_averages_fields
  out_avg_shflx_rlw = .false.
  out_avg_shflx_lat = .false.
  out_avg_shflx_sen = .false.
/

&croco_hbl_averages_fields
  out_avg_hbl = .false.
/

&croco_lmd_bkpp_averages_fields
  out_avg_hbbl = .false.
/

&croco_vis_coef_averages_fields
  out_avg_visc3d = .false.
/

&croco_dif_coef_averages_fields
  out_avg_diff3d = .false.
/

&croco_biology_averages_fields
  out_avg_hel = .false.
/

&croco_morphodyn_averages_fields
  out_avg_hm = .false.
/


! End of namelist
