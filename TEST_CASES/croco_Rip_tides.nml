&croco_title
  title = "RIP Example"
/

&croco_time_stepping
  ntimes = 21600
  dt = 4
  ndtfast = 20
  ninfo = 10
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 0.0d0
  Tcline = 1.e16
/

&croco_history
  ldefhis = .true.
  nwrt = 900
  nrpfhis = 0
  hisname = "rip_his.nc"
/

&croco_initial
  nrrec = 0
/

&croco_restart
  nrst = 21600
  nrpfrst = -1
  rstname = "rip_rst.nc"
/

&croco_grid
  grdname = "rip_grd.nc"
/

&croco_wkb_wwave
  wkb_amp = 0.5
  wkb_ang = 0.
  wkb_prd = 10.
  wkb_tide = 0.0
  wkb_btg = 1.3
  wkb_gam = 0.38
/

&croco_wkb_roller
  wkb_rsb = 0.1
  wkb_roller = 0.5
/

&croco_averages
  ntsavg = 1
  navg = 900
  nrpfavg = 0
  avgname = "rip_avg.nc"
/


! End of namelist
