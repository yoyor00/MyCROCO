&croco_title
  title = "SANDBAR Example"
/

&croco_time_stepping
  ntimes = 36000
  dt = 0.1
  ndtfast = 10
  ninfo = 200
/

&croco_s_coord
  theta_s = 0.0d0
  theta_b = 5.0d0
  Tcline = 2
/

&croco_history
  ldefhis = .true.
  nwrt = 3000
  nrpfhis = 0
  hisname = "sandbar_his.nc"
/

&croco_initial
  nrrec = 0
  ininame = "sandbar_rst.nc"
/

&croco_restart
  nrst = 18000
  nrpfrst = -1
  rstname = "sandbar_rst.nc"
/


! End of namelist
