&croco_title
  title = "BENGUELA TEST MODEL"
/

&croco_time_stepping
  ntimes = 384
  dt = 3600
  ndtfast = 60
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 0.01
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 2.0d0
  Tcline = 200.0d0
/

&croco_use_calendar
  start_date = "2000-01-01 00:00:00"
  end_date = "2000-02-01 00:00:00"
  dt_his = 1
  dt_avg = 6
  dt_rst = 12
/

&croco_history
  ldefhis = .true.
  nwrt = 48
  nrpfhis = 0
  hisname = "CROCO_FILES/croco_his.nc"
/

&croco_initial
  nrrec = 1
  ininame = "CROCO_FILES/croco_ini.nc"
/

&croco_restart
  nrst = 384
  nrpfrst = -1
  rstname = "CROCO_FILES/croco_rst.nc"
/

&croco_grid
  grdname = "CROCO_FILES/croco_grd.nc"
/

&croco_forcing
  frcname = "CROCO_FILES/croco_frc.nc"
/

&croco_bulk_forcing
  bulkname = "CROCO_FILES/croco_blk.nc"
/

&croco_climatology
  clmname = "CROCO_FILES/croco_clm.nc"
/

&croco_biology
  bioname = "CROCO_FILES/croco_frcbio.nc"
/

&croco_boundary
  bry_file = "CROCO_FILES/croco_bry.nc"
/

&croco_wkb_boundary
  brywkb_file = "CROCO_FILES/croco_wkb.nc"
/

&croco_sediments
  sedname = "sediment.in"
/

&croco_sediments_mustang
  sedname_must = "paraMUSTANG.txt"
/

&croco_substance
  subsfilename = "parasubstance.txt"
/

&croco_xios_origin_date
  xios_origin_date = "2014-01-04 00:00:00"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-04
  rdrg2 = 0.d-3
  Zobt = 1.d-2
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_tracer_diff4
  tnu4 = 2*0.d11
/

&croco_vertical_mixing
  Akv_bak = 0.d0
  Akt_bak = 2*0.d0
/

&croco_wkb_wwave
  wkb_amp = 0.25
  wkb_ang = 190.
  wkb_prd = 8.
  wkb_tide = -2.
  wkb_btg = 1.3
  wkb_gam = 0.38
/

&croco_wkb_roller
  wkb_rsb = 0.1
  wkb_roller = 0.5
/

&croco_averages
  ntsavg = 1
  navg = 48
  nrpfavg = 0
  avgname = "CROCO_FILES/croco_avg.nc"
/

&croco_surf
  ldefsurf = .true.
  nwrtsurf = 1
  nrpfsurf = 0
  surfname = "CROCO_FILES/croco_surf.nc"
/

&croco_surf_avg
  ldefsurf_avg = .false.
  ntssurf_avg = 1
  nwrtsurf_avg = 4
  nrpfsurf_avg = 0
  surfname_avg = "CROCO_FILES/croco_surf_avg.nc"
/


! End of namelist
