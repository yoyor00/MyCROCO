&croco_title
  title = "BENGUELA TEST MODEL"
/

&croco_time_stepping
  ntimes = 384
  dt = 3600
  ndtfast = 60
  ninfo = 1
/

&croco_time_stepping_nbq
  csound_nbq = 1000
  visc2_nbq = 0.01
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 2.0d0
  Tcline = 200.0d0
/

&croco_initial
  nrrec = 1
  ininame = "CROCO_FILES/croco_ini.nc"
/

&croco_grid
  grdname = "CROCO_FILES/croco_grd.nc"
/

&croco_forcing
  frcname = "CROCO_FILES/croco_frc.nc"
/

&croco_bulk_forcing
  bulkname = "CROCO_FILES/croco_blk.nc"
/

&croco_climatology
  clmname = "CROCO_FILES/croco_clm.nc"
/

&croco_boundary
  bry_file = "CROCO_FILES/croco_bry.nc"
/

&croco_nudging
  tauT_in = 1.
  tauT_out = 360.
  tauM_in = 3.
  tauM_out = 360.
/

&croco_history
  ldefhis = .true.
  nwrt = 48
  nrpfhis = 0
  hisname = "CROCO_FILES/croco_his.nc"
/

&croco_averages
  ntsavg = 1
  navg = 48
  nrpfavg = 0
  avgname = "CROCO_FILES/croco_avg.nc"
/

&croco_restart
  nrst = 384
  nrpfrst = -1
  rstname = "CROCO_FILES/croco_rst.nc"
/

&croco_rho0
  rho0 = 1025.d0
/

&croco_bottom_drag
  rdrg = 0.0d-04
  rdrg2 = 0.d-3
  Zobt = 1.d-2
  Cdb_min = 1.d-4
  Cdb_max = 1.d-1
/

&croco_gamma2
  gamma2 = 1.d0
/

&croco_lateral_visc
  visc2 = 0.
  visc4 = 0.
/

&croco_tracer_diff2
  tnu2 = 2*0.d0
/

&croco_tracer_diff4
  tnu4 = 2*0.d11
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 48
  nrpfdia = 0
  dianame = "CROCO_FILES/croco_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 48
  nrpfdia_avg = 0
  dianame_avg = "CROCO_FILES/croco_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.d-2
  mld_crit_T = 2.d-1
/

&croco_diagnosticsM
  ldefdiaM = .true.
  nwrtdiaM = 48
  nrpfdiaM = 0
  dianameM = "CROCO_FILES/croco_diaM.nc"
/

&croco_diagM_avg
  ldefdiaM_avg = .true.
  ntsdiaM_avg = 1
  nwrtdiaM_avg = 48
  nrpfdiaM_avg = 0
  dianameM_avg = "CROCO_FILES/croco_diaM_avg.nc"
/

&croco_diags_vrt
  ldefdiags_vrt = .true.
  nwrtdiags_vrt = 48
  nrpfdiags_vrt = 0
  diags_vrtname = "CROCO_FILES/croco_diags_vrt.nc"
/

&croco_diags_vrt_avg
  ldefdiags_vrt_avg = .true.
  ntsdiags_vrt_avg = 1
  nwrtdiags_vrt_avg = 48
  nrpfdiags_vrt_avg = 0
  diags_vrtname_avg = "CROCO_FILES/croco_diags_vrt_avg.nc"
/

&croco_diags_ek
  ldefdiags_ek = .true.
  nwrtdiags_ek = 48
  nrpfdiags_ek = 0
  diags_ekname = "CROCO_FILES/croco_diags_ek.nc"
/

&croco_diags_ek_avg
  ldefdiags_ek_avg = .true.
  ntsdiags_ek_avg = 1
  nwrtdiags_ek_avg = 48
  nrpfdiags_ek_avg = 0
  diags_ekname_avg = "CROCO_FILES/croco_diags_ek_avg.nc"
/

&croco_diags_pv
  ldefdiags_pv = .true.
  nwrtdiags_pv = 48
  nrpfdiags_pv = 0
  diags_pvname = "CROCO_FILES/croco_diags_pv.nc"
/

&croco_diags_pv_avg
  ldefdiags_pv_avg = .true.
  ntsdiags_pv_avg = 1
  nwrtdiags_pv_avg = 48
  nrpfdiags_pv_avg = 0
  diags_pvname_avg = "CROCO_FILES/croco_diags_pv_avg.nc"
/

&croco_diags_eddy_avg
  ldefdiags_eddy_avg = .true.
  ntsdiags_eddy_avg = 1
  nwrtdiags_eddy_avg = 48
  nrpfdiags_eddy_avg = 0
  diags_eddyname_avg = "CROCO_FILES/croco_diags_eddy_avg.nc"
/

&croco_diagnostics_bio
  ldefdiabio = .true.
  nwrtdiabio = 48
  nrpfdiabio = 0
  dianamebio = "CROCO_FILES/croco_diabio.nc"
/

&croco_diagbio_avg
  ldefdiabio_avg = .true.
  ntsdiabio_avg = 1
  nwrtdiabio_avg = 48
  nrpfdiabio_avg = 0
  dianamebio_avg = "CROCO_FILES/croco_diabio_avg.nc"
/

&croco_online
  yearnum = 2000
  monthnum = 1
  recordsperday = 4
  yearend = 2000
  monthend = 3
  pathbulk = "DATA/CFSR_Benguela_LR/"
/

&croco_biology
  bioname = "CROCO_FILES/croco_frcbio.nc"
/

&croco_psource
  psource_Nsrc = 2
/

&croco_psource_ncfile_data
  psource_qbarname = "CROCO_FILES/croco_runoff.nc"
  psource_Isrc(   1) =    24, psource_Jsrc(   1) =    35, psource_Dsrc(   1) =     0, psource_qbardir(   1) =    -1
  psource_Isrc(   2) =    35, psource_Jsrc(   2) =    13, psource_Dsrc(   2) =     1, psource_qbardir(   2) =    -1
/

&croco_psource_tracer
  psource_Lsrc(1,1) = T
  psource_Lsrc(1,2) = T
  psource_Lsrc(2,1) = T
  psource_Lsrc(2,2) = T
  psource_Tsrc0(1,1) = 20.
  psource_Tsrc0(1,2) = 15.
  psource_Tsrc0(2,1) = 20.
  psource_Tsrc0(2,2) = 15.
/

&croco_primary_history_fields
  out_his_zeta = .true.
  out_his_ubar = .true.
  out_his_vbar = .true.
/

&croco_primary_history_3d_fields
  out_his_u = .true.
  out_his_v = .true.
/

&croco_primary_history_tracer_fields
  out_his_tracer = 2*.true.
/

&croco_auxiliary_history_fields
  out_his_rho = .false.
  out_his_omega = .false.
  out_his_w = .true.
  out_his_akv = .false.
  out_his_bostr = .true.
  out_his_bustr = .false.
  out_his_bvstr = .false.
  out_his_wstr = .true.
  out_his_ustr = .true.
  out_his_vstr = .true.
/

