&croco_title
  title = "BENGUELA TEST MODEL"
/

&croco_time_stepping
  ntimes = 384
  dt = 3600
  ndtfast = 60
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 0.01
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 2.0d0
  Tcline = 200.0d0
/

&croco_use_calendar
  start_date = "2000-01-01 00:00:00"
  end_date = "2000-02-01 00:00:00"
  dt_his = 1
  dt_avg = 6
  dt_rst = 12
/

&croco_history
  ldefhis = .true.
  nwrt = 48
  nrpfhis = 0
