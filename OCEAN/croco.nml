&croco_diagnostics_bio
  ldefdiabio = .true.
  nwrtdiabio = 72
  nrpfdiabio = 0
  dianamebio = "CROCO_FILES/croco_diabio.nc"
/

&croco_diagbio_avg
  ldefdiabio_avg = .true.
  ntsdiabio_avg = 1
  nwrtdiabio_avg = 72
  nrpfdiabio_avg = 0
  dianamebio_avg = "CROCO_FILES/croco_diabio_avg.nc"
/


&croco_stations
  ldefsta = .true.
  nsta = 400
  nrpfsta = 0
  staposname = "stations.in"
  staname = "CROCO_FILES/stations.nc"
/

&croco_online
  yearnum = 2000
  monthnum = 1
  recordsperday = 4
