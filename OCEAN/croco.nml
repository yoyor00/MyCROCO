&croco_title
  title = "BENGUELA TEST MODEL"
/

&croco_logfile
  logname = "croco.log"
/

&croco_time_stepping
  ntimes = 720
  dt = 3600
  ndtfast = 60
  ninfo = 1
/

&croco_time_stepping_nbq
  ndtnbq = 1
  csound_nbq = 1000
  visc2_nbq = 0.01
/

&croco_s_coord
  theta_s = 7.0d0
  theta_b = 2.0d0
  Tcline = 200.0d0
/

&croco_use_calendar
  start_date = "2000-01-01 00:00:00"
  end_date = "2000-02-01 00:00:00"
  dt_his = 1
  dt_avg = 6
  dt_rst = 12
/

&croco_history
  ldefhis = .true.
  nwrt = 72
  nrpfhis = 0
  hisname = "CROCO_FILES/croco_his.nc"
/

&croco_initial
  nrrec = 1
  ininame = "CROCO_FILES/croco_ini.nc"
/

&croco_restart
  nrst = 720
  nrpfrst = -1
  rstname = "CROCO_FILES/croco_rst.nc"
/

&croco_grid
  grdname = "CROCO_FILES/croco_grd.nc"
/

&croco_forcing
  frcname = "CROCO_FILES/croco_frc.nc"
/

&croco_bulk_forcing
  bulkname = "CROCO_FILES/croco_blk.nc"
/

&croco_climatology
  clmname = "CROCO_FILES/croco_clm.nc"
/

&croco_biology
  bioname = "CROCO_FILES/croco_frcbio.nc"
/

&croco_boundary
  bry_file = "CROCO_FILES/croco_bry.nc"
/

&croco_wkb_boundary
  brywkb_file = "CROCO_FILES/croco_wkb.nc"
/

&croco_wkb_wwave
  wkb_amp  = 0.25
  wkb_ang  = 190.0
  wkb_prd  = 8.0
  wkb_tide = -2.0
  wkb_btg  = 1.3
  wkb_gam  = 0.38
/

&croco_wkb_roller
  wkb_rsb    = 0.1
  wkb_roller = 0.5
/

&croco_wave_maker
  wmaker_amp = 0.0
  wmaker_prd = 8.0
  wmaker_dir = 0.0
  wmaker_dsp = 0.0
  wmaker_fsp = 3.3
/

&croco_averages
  ntsavg = 1
  navg = 72
  nrpfavg = 0
  avgname = "CROCO_FILES/croco_avg.nc"
/

&croco_diagnostics_ts
  ldefdia = .true.
  nwrtdia = 72
  nrpfdia = 0
  dianame = "CROCO_FILES/croco_dia.nc"
/

&croco_diag_avg
  ldefdia_avg = .true.
  ntsdia_avg = 1
  nwrtdia_avg = 72
  nrpfdia_avg = 0
  dianame_avg = "CROCO_FILES/croco_dia_avg.nc"
/

&croco_diag_mld_dens
  mld_crit_D = 3.e-2
  mld_crit_T = 2.e-1
/

&croco_diagnosticsM
  ldefdiaM = .true.
  nwrtdiaM = 72
  nrpfdiaM = 0
  dianameM = "CROCO_FILES/croco_diaM.nc"
/

&croco_diagM_avg
  ldefdiaM_avg = .true.
  ntsdiaM_avg = 1
  nwrtdiaM_avg = 72
  nrpfdiaM_avg = 0
  dianameM_avg = "CROCO_FILES/croco_diaM_avg.nc"
/

