  ldefdiags_ek = .true.
  nwrtdiags_ek = 72
  nrpfdiags_ek = 0
  diags_ekname = "CROCO_FILES/croco_diags_ek.nc"
/

&croco_diags_ek_avg
  ldefdiags_ek_avg = .true.
  ntsdiags_ek_avg = 1
  nwrtdiags_ek_avg = 72
  nrpfdiags_ek_avg = 0
  diags_ekname_avg = "CROCO_FILES/croco_diags_ek_avg.nc"
/

&croco_diags_pv
  ldefdiags_pv = .true.
  nwrtdiags_pv = 72
  nrpfdiags_pv = 0
  diags_pvname = "CROCO_FILES/croco_diags_pv.nc"
/

&croco_diags_pv_avg
  ldefdiags_pv_avg = .true.
  ntsdiags_pv_avg = 1
  nwrtdiags_pv_avg = 72
  nrpfdiags_pv_avg = 0
  diags_pvname_avg = "CROCO_FILES/croco_diags_pv_avg.nc"
