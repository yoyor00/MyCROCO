{
  // Default KH_INST case
  "KH_INST": {
    "title": "KH_INST (128 x 1 x 128 : 16384)",
    "case": "KH_INST",
    "splitting": { "1": "1x1", "2": "2x1", "4": "4x1" },
    "patches": {},
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_kh_inst.py",
      "plotphy_script_input": "khinst_his.nc",
    },
    "nml_file": "TEST_CASES/croco_KH_INST.nml",
    "cppdefs_file": "TEST_CASES/cppdefs_KH_INST.h",
    "param_file": "TEST_CASES/param_KH_INST.h",
    "check_outputs": ["khinst_his.nc"],
    "unsupported": ["openmp"],
  },
  "KH_INSTY": {
    "title": "KH_INST - Y-slice (1 x 256 x 256 : 65536)",
    "case": "KH_INST",
    "cppkeys": { "KH_INSTY": true },
    "splitting": { "1": "1x1", "2": "1x2", "4": "1x4" },
    "patches": {
      "param.h": [
        {
          "mode": "replace",
          "what": "integer, parameter :: LLm0 = 128",
          "by": "      integer, parameter :: LLm0 = 1",
          "descr": "Switch to Y-slice (LLm0=1)",
        },
        {
          "mode": "replace",
          "what": "integer, parameter :: MMm0 = 1",
          "by": "      integer, parameter :: MMm0 = 256",
          "descr": "Switch to Y-slice (MMm0=256)",
        },
        {
          "mode": "replace",
          "what": "integer, parameter :: N = 128",
          "by": "      integer, parameter :: N = 256",
          "descr": "Switch to Y-slice (N=256)",
        },
      ],
    },
    "nml_file": "TEST_CASES/croco_KH_INST.nml",
    "cppdefs_file": "TEST_CASES/cppdefs_KH_INST.h",
    "param_file": "TEST_CASES/param_KH_INST.h",
    "check_outputs": ["khinst_his.nc"],
    "unsupported": ["openmp"],
  },
  "KH_INST3D": {
    "title": "KH_INST - 3D (256 x 32 x 256)",
    "case": "KH_INST",
    "cppkeys": { "KH_INST3D": true },
    "splitting": { "1": "1x1", "2": "2x1", "4": "4x1" },
    "patches": {
      "param.h": [
        {
          "mode": "replace",
          "what": "integer, parameter :: LLm0 = 128",
          "by": "      integer, parameter :: LLm0 = 256",
          "descr": "Switch to 3D (LLm0=256)",
        },
        {
          "mode": "replace",
          "what": "integer, parameter :: MMm0 = 1",
          "by": "      integer, parameter :: MMm0 = 32",
          "descr": "Switch to 3D (MMm0=32)",
        },
        {
          "mode": "replace",
          "what": "integer, parameter :: N = 128",
          "by": "      integer, parameter :: N = 256",
          "descr": "Switch to 3D (N=256)",
        },
      ],
    },
    "nml_file": "TEST_CASES/croco_KH_INST.nml",
    "cppdefs_file": "TEST_CASES/cppdefs_KH_INST.h",
    "param_file": "TEST_CASES/param_KH_INST.h",
    "check_outputs": ["khinst_his.nc"],
    "unsupported": ["openmp"],
  },
}
