{
  // GRAV_ADJ — Gravitational Adjustment
  // Both cases share cppdefs_Grav_adj.h; NBQ toggled via cppkeys.
  // param files differ (dimensions):
  //   param_Grav_adj.h     : 128 x 1 x 40  (hydrostatic)
  //   param_Grav_adj_nbq.h : 300 x 1 x 30  (NBQ)

  "GRAV_ADJ": {
    "title": "GRAV_ADJ - (128 x 1 x 40 : 5120)",
    "case": "GRAV_ADJ",
    "param_file": "TEST_CASES/param_Grav_adj.h",
    "nml_file": "TEST_CASES/croco_Grav_adj.nml",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_grav_adj.py",
      "plotphy_script_input": "gravadj_his.nc",
    },
    "splitting": { "1": "1x1", "2": "2x1" },
    "patches": {},
    "check_outputs": ["gravadj_his.nc"],
    "unsupported": ["restart"],
  },
  "GRAV_ADJ_NBQ": {
    "title": "GRAV_ADJ_NBQ - (300 x 1 x 30 : 9000)",
    "case": "GRAV_ADJ",
    "cppkeys": { "NBQ": true },
    "param_file": "TEST_CASES/param_Grav_adj_nbq.h",
    "nml_file": "TEST_CASES/croco_Grav_adj_nbq.nml",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_grav_adj.py",
      "plotphy_script_input": "gravadj_his.nc",
      "plotphy_script_options": "--nbq 1",
    },
    "splitting": { "1": "1x1", "2": "2x1" },
    "patches": {},
    "check_outputs": ["gravadj_his.nc"],
    "unsupported": ["restart", "openmp"],
  },
}
