{
  // TS_HADV_TEST — Horizontal tracer advection test cases (100 x 100 x 5)
  //
  // Each case has its own nml file with the appropriate testcase_name and dt.
  //   'TS_HADV_TEST'      : body-forced (no velocity override),  dt=7
  //   'TS_HADV_TEST_DIAG' : constant diagonal velocity,          dt=4
  //   'TS_HADV_TEST_ROT'  : solid-body rotation (freeze u/v),    dt=4
  //   'TS_HADV_TEST_PER'  : cosine-modulated solid-body,         dt=4

  "TS_HADV_TEST": {
    "title": "TS_HADV_TEST - body-forced advection - (100 x 100 x 5 : 50000)",
    "case": "TS_HADV_TEST",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/TS_HADV_TEST/plot_ts_hadv_test.py",
      "plotphy_script_input": "croco_his_body_rot.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "2x3",
      "8": "2x4",
      "16": "4x4",
    },
    "patches": {},
    "check_outputs": ["croco_his_body_rot.nc"],
    "unsupported": ["restart", "openmp"],
  },
  "TS_HADV_TEST_DIAG": {
    "title": "TS_HADV_TEST - diagonal advection - (100 x 100 x 5 : 50000)",
    "case": "TS_HADV_TEST_DIAG",
    "nml_file": "TEST_CASES/TS_HADV_TEST/croco_TS_HADV_TEST_DIAG.nml",
    "cppdefs_file": "TEST_CASES/TS_HADV_TEST/cppdefs_TS_HADV_TEST_DIAG.h",
    "param_file": "TEST_CASES/TS_HADV_TEST/param_TS_HADV_TEST_DIAG.h",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/TS_HADV_TEST/plot_ts_hadv_test.py",
      "plotphy_script_input": "croco_his_diag_adv.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "2x3",
      "8": "2x4",
      "16": "4x4",
    },
    "patches": {},
    "check_outputs": ["croco_his_diag_adv.nc"],
    "unsupported": ["restart", "openmp"],
  },
  "TS_HADV_TEST_ROT": {
    "title": "TS_HADV_TEST - solid-body rotation - (100 x 100 x 5 : 750)",
    "case": "TS_HADV_TEST_ROT",
    "nml_file": "TEST_CASES/TS_HADV_TEST/croco_TS_HADV_TEST_ROT.nml",
    "cppdefs_file": "TEST_CASES/TS_HADV_TEST/cppdefs_TS_HADV_TEST_ROT.h",
    "param_file": "TEST_CASES/TS_HADV_TEST/param_TS_HADV_TEST_ROT.h",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/TS_HADV_TEST/plot_ts_hadv_test.py",
      "plotphy_script_input": "croco_his_diag_adv.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "2x3",
      "8": "2x4",
      "16": "4x4",
    },
    "patches": {},
    "check_outputs": ["croco_his_diag_adv.nc"],
    "unsupported": ["restart", "openmp"],
  },
  "TS_HADV_TEST_PER": {
    "title": "TS_HADV_TEST - cosine-modulated solid-body - (100 x 100 x 5 : 750)",
    "case": "TS_HADV_TEST_PER",
    "nml_file": "TEST_CASES/TS_HADV_TEST/croco_TS_HADV_TEST_PER.nml",
    "cppdefs_file": "TEST_CASES/TS_HADV_TEST/cppdefs_TS_HADV_TEST_PER.h",
    "param_file": "TEST_CASES/TS_HADV_TEST/param_TS_HADV_TEST_PER.h",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/TS_HADV_TEST/plot_ts_hadv_test.py",
      "plotphy_script_input": "croco_his_diag_adv.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "2x3",
      "8": "2x4",
      "16": "4x4",
    },
    "patches": {},
    "check_outputs": ["croco_his_diag_adv.nc"],
    "unsupported": ["restart", "openmp"],
