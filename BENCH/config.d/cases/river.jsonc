{
  // RIVER — River run-off test problem (40 x 80 x 20)
  //
  // Both cases share cppdefs_River.h and param_River.h.
  // PSOURCE_MASS variant toggles mass-conserving point source via cppkeys.

  "RIVER": {
    "title": "RIVER - (40 x 80 x 20 : 800)",
    "case": "RIVER",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/RIVER/plot_river.py",
      "plotphy_script_input": "river_his.nc",
    },
    "splitting": { "1": "1x1", "2": "1x2", "4": "2x2" },
    "patches": {},
    "check_outputs": ["river_his.nc"],
    "unsupported": ["restart"],
  },
  "RIVER_PSOURCE_MASS": {
    "title": "RIVER_PSOURCE_MASS - (40 x 80 x 20 : 800)",
    "case": "RIVER",
    "cppkeys": {
      "PSOURCE_MASS": true,
    },
    "plotphy": {
      "plotphy_script": "./TEST_CASES/RIVER/plot_river.py",
      "plotphy_script_input": "river_his.nc",
    },
    "splitting": { "1": "1x1", "2": "1x2", "4": "2x2" },
    "patches": {},
    "check_outputs": ["river_his.nc"],
    "unsupported": ["restart", "openmp"],
  },
}
