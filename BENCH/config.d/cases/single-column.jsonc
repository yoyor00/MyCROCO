{
  // Single-column (1D water-column) test cases
  //
  // The active experiment is selected at compile time name
  // when it differs from the default.
  //   SC_KATO_PHILLIPS        : N=100
  //   SC_DIURNAL_CYCLE        : N=150
  //   SC_WILLIS_DEARDORFF     : N=50
  //   SC_FORCED_NONROTBBL     : N=50
  //   SC_FORCED_OSCNONROTBBL  : N=50
  //   SC_FORCED_EKBBL         : N=40
  //   SC_FORCED_DBLEEK        : N=25

