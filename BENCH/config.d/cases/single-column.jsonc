    "nml_file": "TEST_CASES/SINGLE_COLUMN/croco_SC_KATO_PHILLIPS.nml",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/SINGLE_COLUMN/plot_single_column.py",
      "plotphy_script_input": "scm_his.nc",
    },
