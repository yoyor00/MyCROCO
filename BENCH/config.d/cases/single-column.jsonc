{
  // SINGLE_COLUMN — 1D water column test cases
  //
  // All cases share cppdefs_Single_column.h (default: KATO_PHILLIPS)
  // and param_Single_column.h (default: N=100).
  // Activate each experiment via cppkeys; patch N when it differs from default.
  //   KATO_PHILLIPS        : N=100 (no patch)
  //   DIURNAL_CYCLE        : N=150
  //   WILLIS_DEARDORFF     : N=50
  //   FORCED_NONROTBBL     : N=50
  //   FORCED_OSCNONROTBBL  : N=50
  //   FORCED_EKBBL         : N=40
  //   FORCED_DBLEEK        : N=25

  "SINGLE_COLUMN_KATO_PHILLIPS": {
    "title": "SINGLE_COLUMN - KATO_PHILLIPS - (5 x 5 x 100 : 3600)",
    "case": "SINGLE_COLUMN",
    "cppkeys": {
      "KATO_PHILLIPS": true,
    },
    "param_file": "TEST_CASES/param_Single_column.h",
    "nml_file": "TEST_CASES/croco_KATO_PHILLIPS.nml",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_single_column.py",
      "plotphy_script_input": "scm_his.nc",
    },
    "splitting": {},
    "patches": {},
    "check_outputs": ["scm_his.nc"],
    "unsupported": ["openmp", "mpi"],
  },
  "SINGLE_COLUMN_DIURNAL_CYCLE": {
    "title": "SINGLE_COLUMN - DIURNAL_CYCLE - (5 x 5 x 150 : 23040)",
    "case": "SINGLE_COLUMN",
    "cppkeys": {
      "KATO_PHILLIPS": false,
      "DIURNAL_CYCLE": true,
    },
    "param_file": "TEST_CASES/param_Single_column.h",
    "nml_file": "TEST_CASES/croco_DIURNALCYCLE.nml",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_single_column.py",
      "plotphy_script_input": "scm_his.nc",
    },
    "splitting": {},
    "patches": {
      "TEST_CASES/param_Single_column.h": {
        "mode": "replace",
        "what": "integer, parameter :: N = 100   ! KATO_PHILLIPS (default)",
        "by": "      integer, parameter :: N = 150   ! DIURNAL_CYCLE",
        "descr": "Switch to N=150 for DIURNAL_CYCLE",
      },
    },
    "check_outputs": ["scm_his.nc"],
    "unsupported": ["openmp", "mpi"],
  },
  "SINGLE_COLUMN_WILLIS_DEARDORFF": {
    "title": "SINGLE_COLUMN - WILLIS_DEARDORFF - (5 x 5 x 50 : 8640)",
