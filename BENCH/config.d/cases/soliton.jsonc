{
  // Default SOLITON case
  "SOLITON": {
    "title": "SOLITON (96 x 32 x 10 : 1200)",
    "case": "SOLITON",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_soliton.py",
      "plotphy_script_input": "soliton_his.nc",
    },
    "splitting": { "1": "1x1", "2": "2x1", "4": "2x2" },
    "patches": {},
    "check_outputs": ["soliton_his.nc", "soliton_avg.nc"],
    "unsupported": ["openacc-native", "openacc-psyclone"],
  },
  // A larger variant
  "SOLITON-LARGE": {
    "title": "SOLITON (960 x 320 x 10 : 1200)",
    "case": "SOLITON",
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "1x6",
      "8": "2x4",
      "12": "2x6",
      "16": "1x16",
      "32": "1x32",
      "64": "1x64",
    },
    "patches": {
      // Change the size of the mesh
      "param.h": [
        {
          "mode": "replace",
          "what": "      integer, parameter :: LLm0 = 96",
          "by": "      integer, parameter :: LLm0 = 960",
          "descr": "Set LLm0 = 960",
        },
        {
          "mode": "replace",
          "what": "      integer, parameter :: MMm0 = 32",
          "by": "      integer, parameter :: MMm0 = 320",
          "descr": "Set MMm0 = 320",
        },
      ],
      // CHange the dt
      "TEST_CASES/croco_Soliton.nml": [
        {
          "mode": "replace",
          "what": "dt = 0.1",
          "by": "dt = 0.01",
          "descr": "Set stepping (dt=0.01)",
        },
        {
          "mode": "replace",
          "what": "nwrt = 80",
          "by": "nwrt = 1200",
          "descr": "Set History steps (nwrt=1200)",
        },
        {
          "mode": "replace",
          "what": "navg = 80",
          "by": "navg = 1200",
          "descr": "Set Average steps (navg=1200)",
        },
      ],
    },
    "check_outputs": ["soliton_his.nc", "soliton_avg.nc"],
    "unsupported": ["openacc-native", "openacc-psyclone"],
  },
}
