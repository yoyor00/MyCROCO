{
  // Default BASIN case
  "BASIN": {
    "title": "BASIN (60 x 50 x 10 : 3240)",
    "case": "BASIN",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_basin.py",
      "plotphy_script_input": "basin_his.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "1x6",
      "8": "2x4",
      "12": "2x6",
      "16": "1x16",
      "32": "1x32",
      "64": "1x64",
    },

    "patches": {},
    "check_outputs": ["basin_his.nc"],
    "unsupported": ["restart"],
  },
  // BASIN STOGEN case
  "BASIN_STOGEN": {
    "title": "BASIN (60 x 50 x 10 : 3240)",
    "case": "BASIN",
    "plotphy": {
      "plotphy_script": "./TEST_CASES/plot_basin.py",
      "plotphy_script_input": "basin_his.nc",
    },
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "3": "3x1",
      "4": "2x2",
      "6": "1x6",
      "8": "2x4",
      "12": "2x6",
      "16": "1x16",
      "32": "1x32",
      "64": "1x64",
    },
    "cppkeys": {
      "STOGEN": true,
    },

    "patches": {
      // Change to use testmpi
      "namelist_sto": [
        {
          "mode": "replace",
          "after": "&namsto",
          "what": "   cn_rngtype = 'default'     ! name of random number generator to use (default, kiss32, kiss64, shr3, testmpi)",
          "by": "   cn_rngtype = 'testmpi'     ! name of random number generator to use (default, kiss32, kiss64, shr3, testmpi)",
          "descr": "Set testmpi random number generator",
        },
        {
          "mode": "replace",
          "after": "&namsto_stress",
          "what": "   npasses = 20 ! number of passes of the horizontal Laplacian filter",
          "by": "   npasses = 0  ! number of passes of the horizontal Laplacian filter",
          "descr": "Set pure white noise",
        },
      ]
    },
    "check_outputs": ["basin_his.nc"],
    "unsupported": ["restart", "openmp"],
  },
    // PARALLEL_FILES LOGFILE BASIN case
    "BASIN_PARALLEL_FILES_LOGFILE": {
      "title": "BASIN (60 x 50 x 10 : 3240)",
      "case": "BASIN",
      "cppkeys": {
        "PARALLEL_FILES": true,
        "LOGFILE": true,
      },
      "splitting": {
        "1": "1x1",
        "2": "1x2",
        "4": "2x2"
      },
      "patches": {},
      "check_outputs": [],
      "unsupported": ["restart", "plotphy", "check"],
    },
  // BASIN a bit larger
  "BASIN-LARGE": {
    "title": "BASIN - LARGE - (200 x 200 x 50 : 100)",
    "case": "BASIN",
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "1x6",
      "8": "2x4",
      "12": "2x6",
      "16": "1x16",
      "32": "1x32",
      "64": "1x64",
    },

    "patches": {
      // Change the size of the mesh
      "param.h": {
        "mode": "replace",
        "after": "#if defined BASIN",
        "what": "      parameter (LLm0=60,   MMm0=50,   N=10)",
        "by": "      parameter (LLm0=200,  MMm0=200,  N=50)",
        "descr": "Set mesh size to (200 x 200 x 50)",
      },
      // Change the dt
      "TEST_CASES/croco_Basin.nml": {
        "mode": "replace",
        "after": "&croco_time_stepping",
        "what": " dt = 9600",
        "by": " dt = 2400",
        "descr": "Set stepping (dt=2400)",
      },
    },
    "check_outputs": ["basin_his.nc"],
  },
  // BASIN a bit huger to stress GPU on gricad bigfoot
  "BASIN-HUGE": {
    "title": "BASIN - HUGE - (400 x 400 x 100 : 100)",
    "case": "BASIN",
    "splitting": {
      "1": "1x1",
      "2": "1x2",
      "4": "2x2",
      "6": "1x6",
      "8": "2x4",
      "12": "2x6",
      "16": "1x16",
      "32": "1x32",
      "64": "1x64",
    },

    "patches": {
      // Change the size of the mesh
      "param.h": {
        "mode": "replace",
        "after": "#if defined BASIN",
        "what": "      parameter (LLm0=60,   MMm0=50,   N=10)",
        "by": "      parameter (LLm0=400,  MMm0=400,  N=100)",
        "descr": "Set mesh size to (400 x 400 x 100)",
      },
      // CHange the dt
      "TEST_CASES/croco_Basin.nml": {
        "mode": "replace",
        "after": "&croco_time_stepping",
        "what": " dt = 9600",
        "by": " dt = 1200",
        "descr": "Set stepping (dt=1200)",
      },
    },
    "check_outputs": ["basin_his.nc"],
  },
}
